---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import { cn } from '@/lib/cn'
import { getDataHookAttributes, layoutDomHooks } from '@/lib/dom-hooks'
import { type getSiteCopy } from '@/lib/site-copy'
import { ui } from '@/lib/ui'

type SiteCopy = ReturnType<typeof getSiteCopy>

type Props = {
  copy: SiteCopy
  newsletterFormAction: string
  privacyHref: string
  termsHref: string
}

const {
  copy,
  newsletterFormAction,
  privacyHref,
  termsHref,
} = Astro.props
---

<section class="mt-4" aria-label={copy.footer.newsletterTitle}>
  <div class={cn(ui.blogFrame, 'py-8 md:py-10')}>
    <div
      class={cn(
        ui.panel,
        ui.spotlightPanel,
        'relative justify-items-center overflow-visible px-5 py-6 text-center md:px-7 md:py-7',
      )}
    >
      <DoodleIcon class="absolute -top-3 right-5 rotate-6 text-site-link-hover" name="note" size={30} />
      <div class="grid justify-items-center gap-2">
        <h2 class="m-0 [font-family:var(--cad-font-book)] text-[1.2rem] font-semibold leading-[1.3] text-site-ink lg:text-[1.38rem]">
          {copy.footer.newsletterTitle}
        </h2>
        <p class={cn(ui.bodyCopy, 'max-w-152')}>
          {copy.footer.newsletterCopy}
        </p>
      </div>
      <form
        action={newsletterFormAction}
        class="mx-auto w-full max-w-lg"
        method="post"
      >
        <label class="sr-only" for={layoutDomHooks.newsletterEmail.id}>Email</label>
        <div class="flex min-h-12 w-full overflow-hidden rounded-md border border-dashed border-site-line-strong bg-site-bg transition-colors duration-150 focus-within:border-site-link-hover focus-within:outline-2 focus-within:outline-offset-3 focus-within:outline-dashed focus-within:outline-site-link-hover">
          <div class="relative min-w-0 flex-1">
            <DoodleIcon class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-site-ink-muted" name="pencil" size={18} />
            <input
              autocomplete="email"
              class="h-full min-h-12 w-full border-0 bg-transparent pr-4 pl-11 [font-family:var(--cad-font-book)] text-[0.98rem] text-site-ink outline-none placeholder:text-site-ink-muted"
              id={layoutDomHooks.newsletterEmail.id}
              name="email"
              placeholder={copy.footer.newsletterInputPlaceholder}
              required
              type="email"
            />
          </div>
          <button
            class="inline-flex min-h-12 shrink-0 items-center justify-center border-l border-dashed border-site-line-strong bg-site-hover px-4 [font-family:var(--cad-font-hand)] text-(--cad-hand-sm) font-semibold text-site-link-hover transition-colors duration-150 hover:border-site-link-hover hover:bg-site-surface-strong hover:text-site-ink focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-dashed focus-visible:outline-site-link-hover"
            type="submit"
          >
            {copy.footer.newsletterSubmitLabel}
          </button>
        </div>
        <input name="EMAIL" type="hidden" value="" {...getDataHookAttributes(layoutDomHooks.newsletterMirror)} />
        <p class="mt-3 mb-0 text-center text-[0.76rem] leading-5 text-site-ink-muted lg:text-[0.82rem]">
          {copy.footer.newsletterDisclaimerBeforeLinks}
          <a class="underline decoration-site-line-strong underline-offset-2 transition-colors duration-150 hover:text-site-link-hover" href={termsHref}>
            {copy.footer.terms}
          </a>
          {copy.footer.newsletterDisclaimerBetweenLinks}
          <a class="underline decoration-site-line-strong underline-offset-2 transition-colors duration-150 hover:text-site-link-hover" href={privacyHref}>
            {copy.footer.privacy}
          </a>
          {copy.footer.newsletterDisclaimerAfterLinks}
        </p>
      </form>
    </div>
  </div>
</section>
