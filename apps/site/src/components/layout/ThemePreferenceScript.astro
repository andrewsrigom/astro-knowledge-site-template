---
import { siteStorageKeys } from '@/lib/site-config'
import { defaultSiteTheme } from '@/lib/theme'
---

<script
  data-default-theme={defaultSiteTheme}
  data-theme-preference-key={siteStorageKeys.themePreference}
  is:inline
>
  try {
    const currentScript = document.currentScript

    if (!(currentScript instanceof HTMLScriptElement)) {
      throw new Error('Missing theme script context')
    }

    const defaultTheme = currentScript.dataset.defaultTheme === 'light' ? 'light' : 'dark'
    const storageKey = currentScript.dataset.themePreferenceKey ?? ''
    const root = document.documentElement

    const readStoredTheme = () => {
      if (!storageKey) {
        return null
      }

      try {
        const value = window.localStorage.getItem(storageKey)
        return value === 'light' || value === 'dark' ? value : null
      } catch {
        return null
      }
    }

    const theme = readStoredTheme() ?? defaultTheme

    root.dataset.theme = theme
    root.style.colorScheme = theme
  } catch {}
</script>
