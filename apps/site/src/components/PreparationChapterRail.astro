---
import NotebookCard from '@/components/ui/notebook/NotebookCard.astro'
import NotebookLink from '@/components/ui/notebook/NotebookLink.astro'
import NotebookTOC from '@/components/ui/notebook/NotebookTOC.astro'

type RailLink = {
  description?: string
  href: string
  title: string
}

type SectionLink = {
  href: string
  title: string
}

type Props = {
  glossary: RailLink[]
  locale: string
  practices: RailLink[]
  sections: SectionLink[]
}

const { glossary, locale, practices, sections } = Astro.props
const labels = locale === 'pt-br'
  ? {
      glossary: 'Conceitos relacionados',
      practices: 'Prática relacionada',
      sections: 'Neste capítulo',
    }
  : {
      glossary: 'Related concepts',
      practices: 'Related practice',
      sections: 'In this chapter',
    }
const tocItems = sections.map((section) => ({
  id: section.href.replace(/^#/, ''),
  level: 2 as const,
  title: section.title,
}))
---

<div class="grid gap-4" data-pagefind-ignore>
  {tocItems.length > 0 ? (
    <NotebookTOC
      ariaLabel={labels.sections}
      items={tocItems}
      selector=".preparation-manual-prose > h2"
      title={labels.sections}
    />
  ) : null}

  {practices.length > 0 ? (
    <NotebookCard
      class="preparation-rail-card"
      cornerFold={false}
      icon="target"
      title={labels.practices}
      tone="accent"
      variant="outlined"
    >
      <ul class="preparation-rail-list">
        {practices.map((practice) => (
          <li>
            <NotebookLink href={practice.href} variant="plain">{practice.title}</NotebookLink>
          </li>
        ))}
      </ul>
    </NotebookCard>
  ) : null}

  {glossary.length > 0 ? (
    <NotebookCard
      class="preparation-rail-card"
      cornerFold={false}
      icon="brackets"
      title={labels.glossary}
      tone="violet"
      variant="outlined"
    >
      <ul class="preparation-rail-list">
        {glossary.map((term) => (
          <li>
            <NotebookLink href={term.href} tone="violet" variant="plain">{term.title}</NotebookLink>
          </li>
        ))}
      </ul>
    </NotebookCard>
  ) : null}
</div>

<style>
  :global(.preparation-rail-card) {
    min-width: 0;
    padding: 1rem 1.05rem 1.1rem;
  }

  .preparation-rail-list {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.35;
    list-style: none;
  }

  .preparation-rail-list li,
  .preparation-rail-list :global(a) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
