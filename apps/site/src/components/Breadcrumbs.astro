---
import type { ArticleBreadcrumbItem } from '@/lib/article-taxonomy'
import NotebookBreadcrumb from '@/components/ui/notebook/NotebookBreadcrumb.astro'

type Props = {
  items: ArticleBreadcrumbItem[]
}

const { items } = Astro.props
---

{items.length > 0 ? (
  <NotebookBreadcrumb
    ariaLabel="Breadcrumb"
    class="site-notebook-breadcrumb"
    items={items.map((item) => ({
      href: item.href ?? undefined,
      label: item.label,
    }))}
  />
) : null}
