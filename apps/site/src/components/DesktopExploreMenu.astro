---
import { cn } from '@/lib/cn'
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import { getNotebookDoodleForPageType } from '@/lib/notebook-doodles'

type ExploreLink = {
  href: string
  isActive: boolean
  label: string
  pageType: string
}

type Props = {
  activeClass?: string
  itemClass?: string
  links?: ExploreLink[]
  menuClass?: string
  triggerClass?: string
  triggerLabel: string
}

const {
  activeClass = '',
  itemClass = '',
  links = [],
  menuClass = '',
  triggerClass = '',
  triggerLabel,
} = Astro.props

const closeMenuOnClick = "this.closest('details')?.removeAttribute('open')"

function getItemClass(isActive: boolean) {
  return isActive ? `${itemClass} ${activeClass}` : itemClass
}
---

<details class="relative" data-dismiss-on-outside="true">
  <summary class={cn(triggerClass, 'list-none [&::-webkit-details-marker]:hidden')}>
    <span>{triggerLabel}</span>
    <DoodleIcon class="rotate-90" name="arrow-right" size={15} />
  </summary>

  <div class={menuClass}>
    {links.map((link) => (
      <a class={getItemClass(link.isActive)} href={link.href} onclick={closeMenuOnClick}>
        <DoodleIcon
          class="shrink-0 text-site-link-hover"
          name={getNotebookDoodleForPageType(link.pageType)}
          size={17}
        />
        {link.label}
      </a>
    ))}
  </div>
</details>
