---
import { getDataHookAttributes, mobileNavMenuDomHooks } from '@/lib/dom-hooks'
import { siteStorageKeys } from '@/lib/storage-keys'
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'

type LinkItem = {
  href: string
  isActive: boolean
  label: string
}

type LocaleLinkItem = LinkItem & {
  code: string
  htmlLang: string
  shortLabel: string
}

type Props = {
  closeLabel: string
  localeOptionActiveClass?: string
  localeSwitchClass?: string
  localeSwitcherLabel: string
  localeLinks?: LocaleLinkItem[]
  menuLabel: string
  mobileLocaleOptionClass?: string
  mobileNavActiveClass?: string
  mobileNavLinkClass?: string
  navLinks?: LinkItem[]
  panelClass?: string
  primaryNavLabel: string
  showLocaleSwitcher?: boolean
}

const {
  closeLabel,
  localeOptionActiveClass = '',
  localeSwitchClass = '',
  localeSwitcherLabel,
  localeLinks = [],
  menuLabel,
  mobileLocaleOptionClass = '',
  mobileNavActiveClass = '',
  mobileNavLinkClass = '',
  navLinks = [],
  panelClass = '',
  primaryNavLabel,
  showLocaleSwitcher = false,
} = Astro.props

const closeMenuOnClick = "this.closest('details')?.removeAttribute('open')"

function getLinkClass(baseClass: string, isActive: boolean, activeClass: string) {
  return isActive ? `${baseClass} ${activeClass}` : baseClass
}

function getLocaleChoiceHandler(code: string) {
  return `try{localStorage.setItem(${JSON.stringify(siteStorageKeys.localePreference)},${JSON.stringify(code)})}catch{};this.closest('details')?.removeAttribute('open')`
}
---

<details
  class="group relative nav:hidden"
  data-dismiss-on-outside="true"
  {...getDataHookAttributes(mobileNavMenuDomHooks.root)}
>
  <summary
    aria-controls="mobile-site-nav"
    aria-label={menuLabel}
    class="inline-flex min-h-10 items-center justify-center rounded-md border border-dashed border-site-line-strong bg-site-panel px-3 py-2 [font-family:var(--notebook-font-hand)] text-(--notebook-hand-sm) font-semibold text-site-ink transition-colors duration-150 hover:bg-site-hover hover:text-site-link-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover list-none [&::-webkit-details-marker]:hidden"
    {...getDataHookAttributes(mobileNavMenuDomHooks.trigger)}
  >
    <DoodleIcon class="group-open:hidden" name="brackets" size={17} />
    <DoodleIcon class="hidden group-open:block" name="cross" size={17} />
    <span class="sr-only">{menuLabel} / {closeLabel}</span>
  </summary>

  <div
    class="absolute right-0 top-[calc(100%+0.75rem)] z-30 w-[min(18rem,calc(100vw-1.5rem))]"
    id="mobile-site-nav"
    {...getDataHookAttributes(mobileNavMenuDomHooks.panel)}
  >
    <div class={panelClass}>
      {navLinks.length > 0 ? (
        <nav aria-label={primaryNavLabel} class="grid gap-1">
          {navLinks.map((link) => (
            <a
              class={getLinkClass(mobileNavLinkClass, link.isActive, mobileNavActiveClass)}
              href={link.href}
              onclick={closeMenuOnClick}
            >
              {link.label}
            </a>
          ))}
        </nav>
      ) : null}

      {showLocaleSwitcher ? (
        <div class="grid gap-2 border-t border-dashed border-site-line-strong pt-3">
          <p class="m-0 [font-family:var(--notebook-font-hand)] text-(--notebook-hand-xs) font-bold uppercase tracking-[0.12em] text-site-line-strong">
            {localeSwitcherLabel}
          </p>
          <div class={`${localeSwitchClass} w-fit flex-wrap`}>
            {localeLinks.map((localeLink) => (
              <a
                class={getLinkClass(mobileLocaleOptionClass, localeLink.isActive, localeOptionActiveClass)}
                href={localeLink.href}
                hreflang={localeLink.htmlLang}
                lang={localeLink.htmlLang}
                onclick={getLocaleChoiceHandler(localeLink.code)}
              >
                {localeLink.shortLabel}
              </a>
            ))}
          </div>
        </div>
      ) : null}
    </div>
  </div>
</details>
