---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { ResolvedPreparationBook } from '@/lib/preparation-book'
import { getPreparationVolumeHref } from '@/lib/preparation-links'

type Props = {
  book: ResolvedPreparationBook
  currentGuideId?: string | null
  currentVolumeId?: string | null
  homeHref: string
  homeLabel: string
  isHome?: boolean
  label: string
}

const {
  book,
  currentGuideId = null,
  currentVolumeId = null,
  homeHref,
  homeLabel,
  isHome = false,
  label,
} = Astro.props

function getNavigationChapterTitle(title: string, volumeTitle: string) {
  const trimmedTitle = title.trim()
  const trimmedVolumeTitle = volumeTitle.trim()

  if (!trimmedTitle.toLocaleLowerCase().startsWith(trimmedVolumeTitle.toLocaleLowerCase())) {
    return trimmedTitle
  }

  return trimmedTitle.slice(trimmedVolumeTitle.length).replace(/^[\s:–—-]+/u, '').trim() || trimmedTitle
}

---

<nav aria-label={label} class="grid gap-3" data-pagefind-ignore>
  <a
    aria-current={isHome ? 'page' : undefined}
    class:list={[
      'book-navigation-link grid grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-2 rounded-md px-2.5 py-2.5 [font-family:var(--cad-font-book)] text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed focus-visible:outline-site-link-hover',
      isHome
        ? 'bg-site-hover text-site-link-hover'
        : 'text-site-ink-soft hover:bg-site-hover hover:text-site-link-hover',
    ]}
    href={homeHref}
  >
    <DoodleIcon name="book" size={17} />
    <span>{homeLabel}</span>
  </a>

  <ol class="m-0 grid list-none gap-1 p-0">
    {book.volumes.map((volume) => {
      const isCurrentVolume = currentVolumeId === volume.id
      const partsWithChapters = volume.parts.filter((part) => part.chapters.length > 0)
      const volumeChapters = partsWithChapters.flatMap((part) => part.chapters)

      return (
        <li>
          <section aria-labelledby={`book-volume-${volume.id}`}>
            <a
              aria-current={isCurrentVolume && !currentGuideId ? 'page' : undefined}
              id={`book-volume-${volume.id}`}
              class:list={[
                'book-navigation-link block rounded-md px-2.5 py-2.5 [font-family:var(--cad-font-book)] text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed focus-visible:outline-site-link-hover',
                isCurrentVolume
                  ? 'bg-site-hover font-semibold text-site-link-hover'
                  : 'font-medium text-site-ink hover:bg-site-hover hover:text-site-link-hover',
              ]}
              href={getPreparationVolumeHref(volume.id, book.catalog.locale)}
            >
              <span class="block min-w-0 truncate leading-5" title={volume.title}>{volume.title}</span>
            </a>

            <div class="mb-2 ml-[1.3rem] mt-1 border-l border-dashed border-site-line-strong pl-3">
              <ol class="m-0 grid list-none gap-0.5 py-1 p-0">
                {volumeChapters.map((chapter) => {
                  const isCurrentChapter = currentGuideId === chapter.guideId
                  const navigationTitle = getNavigationChapterTitle(
                    chapter.guide.data.title,
                    volume.title,
                  )

                  return (
                    <li>
                      <a
                        aria-current={isCurrentChapter ? 'page' : undefined}
                        class:list={[
                          'book-navigation-link block rounded-md px-2 py-2 [font-family:var(--cad-font-book)] text-[0.8rem] leading-5 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed focus-visible:outline-site-link-hover',
                          isCurrentChapter
                            ? 'bg-site-hover font-semibold text-site-link-hover'
                            : 'text-site-ink-soft hover:bg-site-hover hover:text-site-link-hover',
                        ]}
                        href={chapter.href}
                        title={chapter.guide.data.title}
                      >
                        <span class="block min-w-0 truncate">{navigationTitle}</span>
                      </a>
                    </li>
                  )
                })}
              </ol>
            </div>
          </section>
        </li>
      )
    })}
  </ol>
</nav>

<style>
  .book-navigation-link[aria-current='page'] {
    position: relative;
  }

  .book-navigation-link[aria-current='page']::before {
    content: '';
    position: absolute;
    inset: 0 auto 0.15rem 0;
    width: 0.18rem;
    background: var(--site-link-hover);
    border-radius: 999px;
    transform: rotate(-1deg);
  }
</style>
