---
import { cn } from '@/lib/cn'
import { ui } from '@/lib/ui'

type Props = {
  bodyClass?: string
  className?: string
  description?: string
  descriptionClass?: string
  sectionClass?: string
  title: string
  titleClass?: string
  titleTag?: 'h2' | 'h3'
}

const {
  bodyClass = '',
  className = '',
  description,
  descriptionClass = ui.bodyCopy,
  sectionClass = ui.articleSection,
  title,
  titleClass = ui.headingCompact,
  titleTag = 'h2',
} = Astro.props

const HeadingTag = titleTag
---

<section class={cn(sectionClass, className, 'site-notebook-article-section')}>
  <div class={ui.sectionHeader}>
    <div class="grid gap-1">
      <HeadingTag class={titleClass}>{title}</HeadingTag>
      {description ? <p class={descriptionClass}>{description}</p> : null}
      <slot name="header" />
    </div>
  </div>

  {bodyClass ? (
    <div class={bodyClass}>
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

<style>
  .site-notebook-article-section :global(h2),
  .site-notebook-article-section :global(h3) {
    position: relative;
    width: fit-content;
  }

  .site-notebook-article-section :global(h2)::after,
  .site-notebook-article-section :global(h3)::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.32rem;
    left: 0;
    height: 0.16rem;
    background: color-mix(in srgb, var(--site-link-hover) 78%, transparent);
    border-radius: 999px;
    clip-path: polygon(0 40%, 100% 0, 98% 100%, 2% 70%);
  }
</style>
