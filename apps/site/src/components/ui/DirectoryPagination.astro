---
import CadPagination from '@caderno-ui/astro/Pagination.astro'

type Props = {
  currentPage: number
  getHref: (page: number) => string
  nextLabel: string
  pageCount: number
  pageLabel: string
  previousLabel: string
}

const {
  currentPage,
  getHref,
  nextLabel,
  pageCount,
  pageLabel,
  previousLabel,
}: Props = Astro.props
---

{pageCount > 1 ? (
  <CadPagination
    baseHref={getHref(1)}
    class="mt-7"
    getHref={getHref}
    label={`${pageLabel} navigation`}
    nextLabel={nextLabel}
    page={currentPage}
    pageLabel={pageLabel}
    previousLabel={previousLabel}
    total={pageCount}
  />
) : null}
