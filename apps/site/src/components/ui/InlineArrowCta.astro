---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import { cn } from '@/lib/cn'
import { ui } from '@/lib/ui'

type Props = {
  className?: string
  iconClassName?: string
  label: string
}

const {
  className,
  iconClassName = 'size-[0.88rem]',
  label,
} = Astro.props
---

<span class={cn(ui.inlineCta, className)}>
  <span>{label}</span>
  <DoodleIcon class={iconClassName} name="arrow-right" size={15} />
</span>
