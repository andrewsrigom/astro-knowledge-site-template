---
import CadIcon from '@caderno-ui/astro/Icon.astro'

import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  class?: string
  label?: string
  name: NotebookDoodleName
  size?: number | string
}

const {
  class: className,
  label,
  name,
  size = 24,
} = Astro.props
---

<CadIcon class={className} label={label} name={name} size={size} />
