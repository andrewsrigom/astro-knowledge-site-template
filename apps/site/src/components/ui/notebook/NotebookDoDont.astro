---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'

type Props = {
  class?: string
  do: string[]
  doTitle?: string
  dont: string[]
  dontTitle?: string
}

const {
  class: className,
  do: doItems,
  doTitle = 'Faça',
  dont: dontItems,
  dontTitle = 'Não faça',
}: Props = Astro.props
---

<div class:list={['notebook-do-dont', className]}>
  <section class="notebook-do-dont__side" data-kind="do">
    <header><DoodleIcon name="check" size={21} /><h3>{doTitle}</h3></header>
    <ul>{doItems.map((item) => <li>{item}</li>)}</ul>
  </section>
  <section class="notebook-do-dont__side" data-kind="dont">
    <header><DoodleIcon name="cross" size={21} /><h3>{dontTitle}</h3></header>
    <ul>{dontItems.map((item) => <li>{item}</li>)}</ul>
  </section>
</div>

<style>
  .notebook-do-dont {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .notebook-do-dont__side {
    --do-dont-bg: var(--notebook-post-it-mint-bg);
    --do-dont-ink: var(--notebook-post-it-mint-ink);
    overflow: hidden;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--do-dont-bg) 16%, var(--site-surface));
    border: 1px solid color-mix(in srgb, var(--do-dont-ink) 30%, transparent);
    border-radius: 0.75rem 0.95rem 0.7rem 0.9rem;
  }

  .notebook-do-dont__side[data-kind='dont'] {
    --do-dont-bg: var(--notebook-post-it-coral-bg);
    --do-dont-ink: var(--notebook-post-it-coral-ink);
  }

  .notebook-do-dont__side header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1rem;
    color: var(--do-dont-ink);
    background: color-mix(in srgb, var(--do-dont-bg) 72%, var(--site-surface));
  }

  .notebook-do-dont__side h3 {
    margin: 0;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: var(--notebook-hand-weight-strong);
    line-height: 1;
  }

  .notebook-do-dont__side ul {
    display: grid;
    gap: 0.65rem;
    padding: 1rem 1.2rem 1.1rem 2.25rem;
    margin: 0;
    font-family: var(--notebook-font-book);
    line-height: 1.5;
  }

  .notebook-do-dont__side li::marker {
    color: var(--do-dont-ink);
  }

  @media (max-width: 38rem) {
    .notebook-do-dont {
      grid-template-columns: 1fr;
    }
  }
</style>
