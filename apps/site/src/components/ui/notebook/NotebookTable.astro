---
type TableCell = number | string
type TableColumn = {
  key: string
  label: string
}

type Props = {
  caption?: string
  class?: string
  columns: TableColumn[]
  rows: Record<string, TableCell>[]
  zebra?: boolean
}

const {
  caption,
  class: className,
  columns,
  rows,
  zebra = false,
}: Props = Astro.props
---

<div class:list={['notebook-table-wrap', className]} data-zebra={zebra ? 'true' : 'false'}>
  <table class="notebook-table">
    {caption ? <caption>{caption}</caption> : null}
    <thead>
      <tr>{columns.map((column) => <th scope="col">{column.label}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>{columns.map((column) => <td>{row[column.key]}</td>)}</tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .notebook-table-wrap {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--site-line);
    border-radius: 0.7rem 0.9rem 0.65rem 0.85rem;
  }

  .notebook-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
  }

  .notebook-table caption {
    padding: 0.9rem 1rem 0.6rem;
    color: var(--site-ink-muted);
    text-align: left;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-table th,
  .notebook-table td {
    padding: 0.8rem 0.95rem;
    text-align: left;
    border-bottom: 1px dashed var(--site-line-strong);
    vertical-align: top;
  }

  .notebook-table th {
    color: var(--site-ink);
    background: color-mix(in srgb, var(--notebook-post-it-blue-bg) 24%, var(--site-surface));
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .notebook-table-wrap[data-zebra='true'] tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--notebook-post-it-mint-bg) 12%, transparent);
  }

  .notebook-table tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
