---
type Props = {
  class?: string
  current?: number
  label: string
  steps?: number
  value?: number
  variant?: 'bar' | 'ring' | 'steps'
}

const {
  class: className,
  current = 0,
  label,
  steps = 0,
  value = 0,
  variant = 'bar',
}: Props = Astro.props

const normalizedValue = variant === 'steps' && steps > 0
  ? Math.min(1, Math.max(0, current / steps))
  : Math.min(1, Math.max(0, value))
const percentage = Math.round(normalizedValue * 100)
---

<div
  aria-label={label}
  aria-valuemax="100"
  aria-valuemin="0"
  aria-valuenow={percentage}
  class:list={['notebook-progress', className]}
  data-variant={variant}
  role="progressbar"
  style={`--notebook-progress-value: ${percentage}%; --notebook-step-count: ${Math.max(1, steps)}`}
>
  {variant === 'bar' ? (
    <Fragment>
      <div aria-hidden="true" class="notebook-progress__track"><span></span></div>
      <span class="notebook-progress__label">{label}</span>
    </Fragment>
  ) : null}

  {variant === 'steps' ? (
    <Fragment>
      <ol aria-hidden="true" class="notebook-progress__steps">
        {Array.from({ length: Math.max(1, steps) }, (_, index) => (
          <li data-state={index < current ? 'complete' : index === current ? 'current' : 'pending'}>
            <span>{index + 1}</span>
          </li>
        ))}
      </ol>
      <span class="notebook-progress__label">{label}</span>
    </Fragment>
  ) : null}

  {variant === 'ring' ? (
    <Fragment>
      <span aria-hidden="true" class="notebook-progress__ring"><strong>{percentage}%</strong></span>
      <span class="notebook-progress__label">{label}</span>
    </Fragment>
  ) : null}
</div>

<style>
  .notebook-progress {
    display: grid;
    gap: 0.55rem;
    color: var(--site-ink);
  }

  .notebook-progress__track {
    position: relative;
    height: 0.55rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--site-line-strong) 48%, transparent);
    border-radius: 999px;
  }

  .notebook-progress__track::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px dashed color-mix(in srgb, var(--site-ink-muted) 48%, transparent);
  }

  .notebook-progress__track span {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--notebook-progress-value);
    height: 100%;
    background: var(--notebook-post-it-blue-bg);
    box-shadow: inset 0 -0.15rem 0 color-mix(in srgb, var(--notebook-post-it-blue-ink) 14%, transparent);
  }

  .notebook-progress__label {
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-regular);
  }

  .notebook-progress__steps {
    display: grid;
    grid-template-columns: repeat(var(--notebook-step-count, 5), minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .notebook-progress__steps li {
    display: grid;
    place-items: center;
    min-width: 0;
    height: 0.5rem;
    background: color-mix(in srgb, var(--site-line-strong) 48%, transparent);
    border-radius: 999px;
  }

  .notebook-progress__steps li[data-state='complete'],
  .notebook-progress__steps li[data-state='current'] {
    background: var(--notebook-post-it-mint-bg);
  }

  .notebook-progress__steps li[data-state='current'] {
    outline: 2px solid color-mix(in srgb, var(--notebook-post-it-mint-ink) 42%, transparent);
    outline-offset: 2px;
  }

  .notebook-progress__steps li span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .notebook-progress[data-variant='ring'] {
    justify-items: center;
    width: fit-content;
    text-align: center;
  }

  .notebook-progress__ring {
    display: grid;
    place-items: center;
    width: 5.5rem;
    aspect-ratio: 1;
    padding: 0.55rem;
    background: conic-gradient(var(--notebook-post-it-blue-bg) var(--notebook-progress-value), var(--site-line) 0);
    border-radius: 50% 48% 52% 47%;
  }

  .notebook-progress__ring::before {
    content: '';
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    background: var(--site-surface);
    border-radius: 48% 52% 47% 53%;
  }

  .notebook-progress__ring strong {
    position: relative;
    grid-area: 1 / 1;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: var(--notebook-hand-weight-strong);
  }
</style>
