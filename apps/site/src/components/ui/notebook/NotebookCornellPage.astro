---
import NotebookDivider from '@/components/ui/notebook/NotebookDivider.astro'

type Props = {
  class?: string
  cueTitle?: string
  notesTitle?: string
  summaryTitle?: string
}

const {
  class: className,
  cueTitle = 'Pistas',
  notesTitle = 'Notas',
  summaryTitle = 'Resumo',
} = Astro.props
---

<article class:list={['notebook-cornell', className]}>
  <section class="notebook-cornell__cue">
    <h3 class="notebook-cornell__title">{cueTitle}</h3>
    <div class="notebook-cornell__body"><slot name="cue" /></div>
  </section>
  <div class="notebook-cornell__vertical">
    <NotebookDivider orientation="vertical" variant="dashed" tone="muted" density="loose" />
  </div>
  <section class="notebook-cornell__notes">
    <h3 class="notebook-cornell__title">{notesTitle}</h3>
    <div class="notebook-cornell__body"><slot name="notes" /></div>
  </section>
  <div class="notebook-cornell__horizontal">
    <NotebookDivider variant="dashed" tone="muted" density="loose" />
  </div>
  <section class="notebook-cornell__summary">
    <h3 class="notebook-cornell__title">{summaryTitle}</h3>
    <div class="notebook-cornell__body"><slot name="summary" /></div>
  </section>
</article>

<style>
  .notebook-cornell {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) auto 1fr;
    grid-template-areas:
      'cue vdiv notes'
      'hdiv hdiv hdiv'
      'summary summary summary';
    gap: 1.15rem 1.35rem;
    margin: 0;
    padding: 0;
  }

  .notebook-cornell__cue {
    grid-area: cue;
    padding-right: 0.35rem;
  }

  .notebook-cornell__vertical {
    grid-area: vdiv;
    display: flex;
    align-self: stretch;
  }

  .notebook-cornell__notes {
    grid-area: notes;
    padding-left: 0.35rem;
  }

  .notebook-cornell__horizontal {
    grid-area: hdiv;
  }

  .notebook-cornell__summary {
    grid-area: summary;
  }

  .notebook-cornell__title {
    margin: 0 0 0.4rem;
    color: color-mix(in srgb, var(--notebook-post-it-coral-ink) 78%, var(--site-ink));
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notebook-cornell__body {
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.45;
  }

  .notebook-cornell__body :global(> :first-child) {
    margin-top: 0;
  }

  .notebook-cornell__body :global(> :last-child) {
    margin-bottom: 0;
  }

  .notebook-cornell__body :global(p) {
    margin: 0 0 0.55rem;
  }

  .notebook-cornell__body :global(ul),
  .notebook-cornell__body :global(ol) {
    margin: 0 0 0.55rem;
    padding-left: 1.15rem;
  }

  .notebook-cornell__body :global(li) {
    margin-bottom: 0.2rem;
  }

  @media (max-width: 40rem) {
    .notebook-cornell {
      grid-template-columns: 1fr;
      grid-template-areas:
        'cue'
        'hdiv'
        'notes'
        'hdiv'
        'summary';
      gap: 0.9rem;
    }
    .notebook-cornell__vertical {
      display: none;
    }
    .notebook-cornell__cue,
    .notebook-cornell__notes {
      padding: 0;
    }
  }
</style>
