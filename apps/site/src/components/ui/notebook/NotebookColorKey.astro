---
type ColorKeyItem = {
  label: string
  tone: 'blue' | 'coral' | 'green' | 'lemon' | 'mint' | 'orange' | 'pink' | 'violet' | 'yellow'
}

type Props = {
  class?: string
  columns?: 1 | 2 | 3
  items: ColorKeyItem[]
  title?: string
}

const {
  class: className,
  columns = 2,
  items,
  title,
} = Astro.props
---

<section class:list={['notebook-color-key', className]} data-columns={columns}>
  {title ? <h3 class="notebook-color-key__title">{title}</h3> : null}
  <ul class="notebook-color-key__list">
    {items.map((item) => (
      <li class="notebook-color-key__item">
        <span aria-hidden="true" class="notebook-color-key__dot" data-tone={item.tone}></span>
        <span class="notebook-color-key__label">{item.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .notebook-color-key {
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem 1.25rem 1.25rem;
    background: color-mix(in srgb, var(--site-surface) 92%, transparent);
    border: 1px solid var(--site-line);
    border-radius: 0.85rem 1.1rem 0.9rem 1.05rem;
  }

  .notebook-color-key__title {
    margin: 0;
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .notebook-color-key__list {
    display: grid;
    grid-template-columns: repeat(var(--columns, 2), minmax(0, 1fr));
    gap: 0.55rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notebook-color-key[data-columns='1'] .notebook-color-key__list {
    --columns: 1;
  }

  .notebook-color-key[data-columns='2'] .notebook-color-key__list {
    --columns: 2;
  }

  .notebook-color-key[data-columns='3'] .notebook-color-key__list {
    --columns: 3;
  }

  .notebook-color-key__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--site-ink);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .notebook-color-key__dot {
    --dot: var(--notebook-sticker-blue-bg);
    --dot-ink: var(--notebook-sticker-blue-ink);
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
    background: var(--dot);
    border-radius: 54% 46% 52% 48%;
    box-shadow:
      inset 0 -0.14rem 0.28rem rgb(var(--notebook-shadow-rgb) / 0.18),
      0 0 0 1.5px color-mix(in srgb, var(--dot-ink) 40%, transparent);
    transform: rotate(-4deg);
  }

  .notebook-color-key__dot[data-tone='coral'] {
    --dot: var(--notebook-sticker-coral-bg);
    --dot-ink: var(--notebook-sticker-coral-ink);
  }

  .notebook-color-key__dot[data-tone='lemon'],
  .notebook-color-key__dot[data-tone='yellow'] {
    --dot: var(--notebook-sticker-lemon-bg);
    --dot-ink: var(--notebook-sticker-lemon-ink);
  }

  .notebook-color-key__dot[data-tone='mint'],
  .notebook-color-key__dot[data-tone='green'] {
    --dot: var(--notebook-sticker-mint-bg);
    --dot-ink: var(--notebook-sticker-mint-ink);
  }

  .notebook-color-key__dot[data-tone='violet'] {
    --dot: var(--notebook-sticker-violet-bg);
    --dot-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-color-key__dot[data-tone='pink'] {
    --dot: var(--notebook-post-it-pink-bg);
    --dot-ink: var(--notebook-post-it-pink-ink);
  }

  .notebook-color-key__dot[data-tone='orange'] {
    --dot: var(--notebook-post-it-coral-bg);
    --dot-ink: var(--notebook-post-it-coral-ink);
  }
</style>
