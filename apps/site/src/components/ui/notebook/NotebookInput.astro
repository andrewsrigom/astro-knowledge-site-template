---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  autocomplete?: string
  class?: string
  hint?: string
  icon?: NotebookDoodleName
  id: string
  invalid?: boolean
  label: string
  name?: string
  placeholder?: string
  required?: boolean
  size?: 'lg' | 'md' | 'sm'
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
  type?: 'email' | 'password' | 'search' | 'tel' | 'text' | 'url'
  value?: string
}

const {
  autocomplete,
  class: className,
  hint,
  icon,
  id,
  invalid = false,
  label,
  name,
  placeholder,
  required = false,
  size = 'md',
  tone = 'accent',
  type = 'text',
  value,
} = Astro.props

const describedBy = hint ? `${id}-hint` : undefined
---

<div class:list={['notebook-input', className]} data-invalid={invalid ? 'true' : 'false'} data-size={size} data-tone={tone}>
  <label class="notebook-input__label" for={id}>
    {label}
    {required ? <span aria-hidden="true" class="notebook-input__required">*</span> : null}
  </label>
  <div class="notebook-input__field">
    {icon ? (
      <span aria-hidden="true" class="notebook-input__icon">
        <DoodleIcon name={icon} size={size === 'sm' ? 16 : 18} />
      </span>
    ) : null}
    <input
      aria-describedby={describedBy}
      aria-invalid={invalid || undefined}
      autocomplete={autocomplete}
      class="notebook-input__control"
      id={id}
      name={name ?? id}
      placeholder={placeholder}
      required={required}
      type={type}
      value={value}
    />
  </div>
  {hint ? (
    <p class="notebook-input__hint" id={describedBy}>{hint}</p>
  ) : null}
</div>

<style>
  .notebook-input {
    --input-ink: var(--site-ink);
    --input-line: color-mix(in srgb, var(--notebook-post-it-blue-ink) 55%, transparent);
    --input-focus: color-mix(in srgb, var(--notebook-post-it-blue-ink) 82%, var(--site-link-hover));
    --input-hint: var(--site-ink-muted);
    display: grid;
    gap: 0.35rem;
  }

  .notebook-input[data-tone='coral'] {
    --input-line: color-mix(in srgb, var(--notebook-post-it-coral-ink) 55%, transparent);
    --input-focus: var(--notebook-post-it-coral-ink);
  }
  .notebook-input[data-tone='mint'] {
    --input-line: color-mix(in srgb, var(--notebook-post-it-mint-ink) 55%, transparent);
    --input-focus: var(--notebook-post-it-mint-ink);
  }
  .notebook-input[data-tone='lemon'] {
    --input-line: color-mix(in srgb, var(--notebook-post-it-lemon-ink) 60%, transparent);
    --input-focus: var(--notebook-post-it-lemon-ink);
  }
  .notebook-input[data-tone='pink'] {
    --input-line: color-mix(in srgb, var(--notebook-post-it-pink-ink) 55%, transparent);
    --input-focus: var(--notebook-post-it-pink-ink);
  }
  .notebook-input[data-tone='violet'] {
    --input-line: color-mix(in srgb, var(--notebook-sticker-violet-ink) 55%, transparent);
    --input-focus: var(--notebook-sticker-violet-ink);
  }

  .notebook-input[data-invalid='true'] {
    --input-line: color-mix(in srgb, var(--notebook-post-it-coral-ink) 78%, transparent);
    --input-focus: var(--notebook-post-it-coral-ink);
  }

  .notebook-input__label {
    color: var(--input-focus);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .notebook-input__required {
    margin-left: 0.15rem;
    color: var(--notebook-post-it-coral-ink);
  }

  .notebook-input__field {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.3rem 0.15rem 0.55rem;
    /* linha de caderno tracejada como underline */
    background-image: repeating-linear-gradient(
      90deg,
      var(--input-line) 0,
      var(--input-line) 5px,
      transparent 5px,
      transparent 10px
    );
    background-repeat: no-repeat;
    background-size: 100% 1.5px;
    background-position: 0 100%;
    transition: background-image 140ms var(--site-transition-smooth);
  }

  .notebook-input__field:focus-within {
    background-image: linear-gradient(90deg, var(--input-focus), var(--input-focus));
  }

  .notebook-input__icon {
    display: inline-grid;
    place-items: center;
    color: var(--input-focus);
    transform: translateY(2px) rotate(-4deg);
  }

  .notebook-input__control {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    margin: 0;
    color: var(--input-ink);
    background: transparent;
    border: 0;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.35;
  }

  .notebook-input[data-size='sm'] .notebook-input__control {
    font-size: var(--notebook-hand-sm);
  }

  .notebook-input[data-size='lg'] .notebook-input__control {
    font-size: var(--notebook-hand-lg);
  }

  .notebook-input__control::placeholder {
    color: color-mix(in srgb, var(--site-ink-muted) 78%, transparent);
    font-family: var(--notebook-font-hand);
    font-style: italic;
  }

  .notebook-input__control:focus {
    outline: none;
  }

  .notebook-input__control:focus-visible {
    outline: 2px dashed var(--input-focus);
    outline-offset: 4px;
    border-radius: 0.2rem;
  }

  .notebook-input__control:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .notebook-input__hint {
    margin: 0;
    color: var(--input-hint);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    line-height: 1.3;
  }

  .notebook-input[data-invalid='true'] .notebook-input__hint {
    color: var(--notebook-post-it-coral-ink);
  }
</style>
