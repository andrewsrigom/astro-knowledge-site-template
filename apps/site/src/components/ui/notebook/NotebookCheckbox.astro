---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'

type Props = {
  checked?: boolean
  class?: string
  disabled?: boolean
  hint?: string
  id: string
  label: string
  name?: string
  required?: boolean
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
  value?: string
}

const {
  checked = false,
  class: className,
  disabled = false,
  hint,
  id,
  label,
  name,
  required = false,
  tone = 'accent',
  value,
} = Astro.props
---

<label class:list={['notebook-checkbox', className]} data-tone={tone} data-disabled={disabled ? 'true' : 'false'} for={id}>
  <input
    checked={checked}
    class="notebook-checkbox__input"
    disabled={disabled}
    id={id}
    name={name ?? id}
    required={required}
    type="checkbox"
    value={value}
  />
  <span aria-hidden="true" class="notebook-checkbox__box">
    <span class="notebook-checkbox__mark">
      <DoodleIcon name="check" size={16} />
    </span>
  </span>
  <span class="notebook-checkbox__body">
    <span class="notebook-checkbox__label">{label}</span>
    {hint ? <span class="notebook-checkbox__hint">{hint}</span> : null}
  </span>
</label>

<style>
  .notebook-checkbox {
    --check-ink: var(--notebook-post-it-blue-ink);
    --check-bg: var(--notebook-post-it-blue-bg);
    display: inline-grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;
    color: var(--site-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .notebook-checkbox[data-tone='coral'] {
    --check-ink: var(--notebook-post-it-coral-ink);
    --check-bg: var(--notebook-post-it-coral-bg);
  }
  .notebook-checkbox[data-tone='mint'] {
    --check-ink: var(--notebook-post-it-mint-ink);
    --check-bg: var(--notebook-post-it-mint-bg);
  }
  .notebook-checkbox[data-tone='lemon'] {
    --check-ink: var(--notebook-post-it-lemon-ink);
    --check-bg: var(--notebook-post-it-lemon-bg);
  }
  .notebook-checkbox[data-tone='pink'] {
    --check-ink: var(--notebook-post-it-pink-ink);
    --check-bg: var(--notebook-post-it-pink-bg);
  }
  .notebook-checkbox[data-tone='violet'] {
    --check-ink: var(--notebook-sticker-violet-ink);
    --check-bg: var(--notebook-sticker-violet-bg);
  }

  .notebook-checkbox[data-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .notebook-checkbox__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .notebook-checkbox__box {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.1rem;
    background: transparent;
    border: 2px solid color-mix(in srgb, var(--check-ink) 55%, transparent);
    /* borda "torta" para look à mão */
    border-radius: 0.35rem 0.55rem 0.3rem 0.5rem;
    color: var(--check-ink);
    transition: background-color 140ms var(--site-transition-smooth), border-color 140ms var(--site-transition-smooth), transform 140ms var(--site-transition-smooth);
    transform: rotate(-2deg);
  }

  .notebook-checkbox__mark {
    display: inline-grid;
    place-items: center;
    color: var(--check-ink);
    opacity: 0;
    transform: scale(0.6) rotate(-6deg);
    transition: opacity 120ms var(--site-transition-smooth), transform 160ms var(--site-transition-smooth);
  }

  .notebook-checkbox__input:checked ~ .notebook-checkbox__box {
    background-color: color-mix(in srgb, var(--check-bg) 68%, transparent);
    border-color: var(--check-ink);
  }

  .notebook-checkbox__input:checked ~ .notebook-checkbox__box .notebook-checkbox__mark {
    opacity: 1;
    transform: scale(1) rotate(-6deg);
  }

  .notebook-checkbox__input:focus-visible ~ .notebook-checkbox__box {
    outline: 2px dashed var(--check-ink);
    outline-offset: 3px;
  }

  .notebook-checkbox:hover:not([data-disabled='true']) .notebook-checkbox__box {
    transform: rotate(-2deg) translateY(-1px);
  }

  .notebook-checkbox__body {
    display: inline-grid;
    gap: 0.15rem;
    padding-top: 0.1rem;
  }

  .notebook-checkbox__label {
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.25;
  }

  .notebook-checkbox__hint {
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    line-height: 1.3;
  }
</style>
