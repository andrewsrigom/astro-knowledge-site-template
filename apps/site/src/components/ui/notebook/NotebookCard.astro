---
import CadCard from '@caderno-ui/astro/Card.astro'
import CadCardContent from '@caderno-ui/astro/CardContent.astro'
import CadCardFooter from '@caderno-ui/astro/CardFooter.astro'
import CadCardHeader from '@caderno-ui/astro/CardHeader.astro'
import CadCardKicker from '@caderno-ui/astro/CardKicker.astro'
import CadCardTitle from '@caderno-ui/astro/CardTitle.astro'
import CadIcon from '@caderno-ui/astro/Icon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Tone = 'accent' | 'coral' | 'lemon' | 'mint' | 'neutral' | 'pink' | 'violet'
type Props = {
  class?: string
  cornerFold?: boolean
  href?: string
  icon?: NotebookDoodleName
  kicker?: string
  title?: string
  tone?: Tone
  variant?: 'outlined' | 'paper'
}

const {
  class: className,
  cornerFold = false,
  href,
  icon,
  kicker,
  title,
  tone = 'neutral',
  variant = 'paper',
}: Props = Astro.props
const cadernoTone = tone === 'accent' ? 'blue' : tone
---

<CadCard
  class:list={['notebook-card', className]}
  folded={cornerFold}
  href={href}
  tone={cadernoTone}
  variant={variant}
>
  {title || kicker ? (
    <CadCardHeader>
      {kicker ? <CadCardKicker>{kicker}</CadCardKicker> : null}
      {title ? (
        <CadCardTitle as="h3">
          {icon ? <CadIcon name={icon} size={20} /> : null}
          {title}
        </CadCardTitle>
      ) : null}
    </CadCardHeader>
  ) : null}
  <CadCardContent><slot /></CadCardContent>
  {Astro.slots.has('footer') ? (
    <CadCardFooter><slot name="footer" /></CadCardFooter>
  ) : null}
</CadCard>
