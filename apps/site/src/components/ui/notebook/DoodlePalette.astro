---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import {
  notebookDoodleCategories,
  type NotebookDoodleName,
} from '@/lib/notebook-doodles'

const labels: Record<NotebookDoodleName, string> = {
  api: 'API',
  'arrow-left': 'Seta para esquerda',
  'arrow-right': 'Seta para direita',
  book: 'Livro',
  bookmark: 'Marcador',
  box: 'Caixa',
  brackets: 'Colchetes',
  brain: 'Cérebro',
  branch: 'Branch',
  bug: 'Bug',
  check: 'Confirmação',
  checklist: 'Checklist',
  clock: 'Relógio',
  cloud: 'Nuvem',
  code: 'Código',
  cross: 'Erro',
  database: 'Banco de dados',
  exclamation: 'Atenção',
  gauge: 'Performance',
  gear: 'Engrenagem',
  highlight: 'Marca-texto',
  layers: 'Camadas',
  lightbulb: 'Ideia',
  lock: 'Segurança',
  network: 'Rede',
  note: 'Nota',
  pencil: 'Lápis',
  pin: 'Alfinete',
  question: 'Pergunta',
  reset: 'Revisar',
  rocket: 'Entrega',
  scribble: 'Rabisco',
  search: 'Busca',
  server: 'Servidor',
  spark: 'Destaque',
  star: 'Estrela',
  tape: 'Fita',
  target: 'Objetivo',
  terminal: 'Terminal',
  underline: 'Sublinhado',
}
---

<div class="doodle-palette">
  {notebookDoodleCategories.map((category) => (
    <section aria-labelledby={`doodle-category-${category.id}`} class="doodle-category">
      <header class="doodle-category__header">
        <h2 id={`doodle-category-${category.id}`}>{category.label}</h2>
        <span>{category.icons.length} desenhos</span>
      </header>
      <ul class="doodle-grid">
        {category.icons.map((name) => (
          <li class="doodle-swatch">
            <DoodleIcon label={labels[name]} name={name} size={30} />
            <span>{labels[name]}</span>
            <code>{name}</code>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .doodle-palette {
    display: grid;
    gap: 3rem;
  }

  .doodle-category {
    display: grid;
    gap: 1rem;
  }

  .doodle-category__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--site-line);
    padding-bottom: 0.75rem;
  }

  .doodle-category__header h2,
  .doodle-category__header span {
    margin: 0;
  }

  .doodle-category__header h2 {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: 1.45rem;
  }

  .doodle-category__header span {
    color: var(--site-ink-muted);
    font-size: 0.75rem;
  }

  .doodle-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doodle-swatch {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.1rem 0.75rem;
    align-items: center;
    min-height: 4.75rem;
    padding: 0.8rem;
    border: 1px solid var(--site-line);
    border-radius: 0.45rem;
    color: var(--book-pencil);
    background: color-mix(in srgb, var(--site-surface) 86%, transparent);
  }

  .doodle-swatch span {
    color: var(--site-ink);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .doodle-swatch code {
    grid-column: 2;
    color: var(--site-ink-muted);
    font-size: 0.68rem;
  }
</style>
