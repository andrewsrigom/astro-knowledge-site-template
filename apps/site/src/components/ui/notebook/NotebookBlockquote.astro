---
type Props = {
  author?: string
  cite?: string
  class?: string
  source?: string
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'violet'
}

const {
  author,
  cite,
  class: className,
  source,
  tone = 'accent',
}: Props = Astro.props
---

<figure class:list={['notebook-blockquote', className]} data-tone={tone}>
  <blockquote cite={cite}>
    <span aria-hidden="true" class="notebook-blockquote__mark">“</span>
    <div><slot /></div>
  </blockquote>
  {author || source ? (
    <figcaption>
      {author ? <strong>{author}</strong> : null}
      {author && source ? <span aria-hidden="true"> · </span> : null}
      {cite && source ? <a href={cite}>{source}</a> : source}
    </figcaption>
  ) : null}
</figure>

<style>
  .notebook-blockquote {
    --quote-mark: var(--notebook-post-it-blue-bg);
    --quote-ink: var(--notebook-post-it-blue-ink);
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 1.35rem 1.45rem 1.15rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--quote-mark) 12%, var(--site-surface));
    border-left: 0.35rem solid color-mix(in srgb, var(--quote-ink) 55%, transparent);
    border-radius: 0.35rem 0.85rem 0.7rem 0.35rem;
  }

  .notebook-blockquote[data-tone='coral'] { --quote-mark: var(--notebook-post-it-coral-bg); --quote-ink: var(--notebook-post-it-coral-ink); }
  .notebook-blockquote[data-tone='lemon'] { --quote-mark: var(--notebook-post-it-lemon-bg); --quote-ink: var(--notebook-post-it-lemon-ink); }
  .notebook-blockquote[data-tone='mint'] { --quote-mark: var(--notebook-post-it-mint-bg); --quote-ink: var(--notebook-post-it-mint-ink); }
  .notebook-blockquote[data-tone='violet'] { --quote-mark: var(--notebook-sticker-violet-bg); --quote-ink: var(--notebook-sticker-violet-ink); }

  .notebook-blockquote blockquote {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    margin: 0;
  }

  .notebook-blockquote__mark {
    color: var(--quote-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-2xl);
    font-weight: var(--notebook-hand-weight-strong);
    line-height: 0.72;
    transform: rotate(-2deg);
  }

  .notebook-blockquote blockquote div {
    font-family: var(--notebook-font-book);
    font-size: 1.06rem;
    font-style: italic;
    line-height: 1.65;
  }

  .notebook-blockquote blockquote :global(> div > :first-child) { margin-top: 0; }
  .notebook-blockquote blockquote :global(> div > :last-child) { margin-bottom: 0; }

  .notebook-blockquote figcaption {
    padding-left: 3rem;
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
  }

  .notebook-blockquote figcaption a {
    color: var(--site-link-hover);
    text-decoration: underline;
    text-underline-offset: 0.18rem;
  }

  .notebook-blockquote figcaption a:focus-visible {
    outline: 2px dashed var(--site-link-hover);
    outline-offset: 3px;
  }
</style>
