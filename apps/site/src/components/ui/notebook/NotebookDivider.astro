---
import CadDivider from '@caderno-ui/astro/Divider.astro'

type Props = {
  class?: string
  density?: 'dense' | 'loose' | 'regular'
  orientation?: 'horizontal' | 'vertical'
  tone?: 'accent' | 'ink' | 'muted' | 'strong'
  variant?: 'dashed' | 'dotted' | 'wavy'
}

const {
  class: className,
  density = 'regular',
  orientation = 'horizontal',
  tone = 'muted',
  variant = 'dashed',
}: Props = Astro.props
---

<CadDivider
  class:list={['notebook-divider', className]}
  density={density}
  orientation={orientation}
  tone={tone}
  variant={variant}
/>
