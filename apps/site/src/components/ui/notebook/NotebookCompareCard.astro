---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Side = {
  icon?: NotebookDoodleName
  title: string
  tone: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  class?: string
  divider?: string
  left: Side
  right: Side
}

const {
  class: className,
  divider = 'VS',
  left,
  right,
} = Astro.props
---

<div class:list={['notebook-compare', className]}>
  <section class="notebook-compare__side" data-tone={left.tone}>
    <header class="notebook-compare__side-header">
      {left.icon ? <DoodleIcon name={left.icon} size={22} /> : null}
      <h3>{left.title}</h3>
    </header>
    <div class="notebook-compare__side-content"><slot name="left" /></div>
  </section>

  <div aria-hidden="true" class="notebook-compare__divider">
    <span class="notebook-compare__divider-line"></span>
    <span class="notebook-compare__divider-badge">{divider}</span>
    <span class="notebook-compare__divider-line"></span>
  </div>

  <section class="notebook-compare__side" data-tone={right.tone}>
    <header class="notebook-compare__side-header">
      {right.icon ? <DoodleIcon name={right.icon} size={22} /> : null}
      <h3>{right.title}</h3>
    </header>
    <div class="notebook-compare__side-content"><slot name="right" /></div>
  </section>
</div>

<style>
  .notebook-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0.5rem;
  }

  @media (max-width: 42rem) {
    .notebook-compare {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }
  }

  .notebook-compare__side {
    --side-bg: var(--notebook-post-it-blue-bg);
    --side-ink: var(--notebook-post-it-blue-ink);
    display: grid;
    gap: 0.65rem;
    padding: 1.15rem 1.2rem 1.25rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--side-bg) 32%, var(--site-surface));
    border: 1.5px dashed color-mix(in srgb, var(--side-ink) 40%, transparent);
    border-radius: 0.9rem 1.15rem 0.85rem 1.1rem;
  }

  .notebook-compare__side[data-tone='coral'] {
    --side-bg: var(--notebook-post-it-coral-bg);
    --side-ink: var(--notebook-post-it-coral-ink);
  }

  .notebook-compare__side[data-tone='mint'] {
    --side-bg: var(--notebook-post-it-mint-bg);
    --side-ink: var(--notebook-post-it-mint-ink);
  }

  .notebook-compare__side[data-tone='lemon'] {
    --side-bg: var(--notebook-post-it-lemon-bg);
    --side-ink: var(--notebook-post-it-lemon-ink);
  }

  .notebook-compare__side[data-tone='pink'] {
    --side-bg: var(--notebook-post-it-pink-bg);
    --side-ink: var(--notebook-post-it-pink-ink);
  }

  .notebook-compare__side[data-tone='violet'] {
    --side-bg: var(--notebook-sticker-violet-bg);
    --side-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-compare__side-header {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--side-ink);
  }

  .notebook-compare__side-header h3 {
    margin: 0;
    font-family: var(--notebook-font-hand);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .notebook-compare__side-content {
    color: var(--site-ink);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .notebook-compare__side-content :global(> :first-child) {
    margin-top: 0;
  }

  .notebook-compare__side-content :global(> :last-child) {
    margin-bottom: 0;
  }

  .notebook-compare__divider {
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
    align-items: center;
    padding-inline: 0.4rem;
    min-width: 3.2rem;
  }

  @media (max-width: 42rem) {
    .notebook-compare__divider {
      grid-template-rows: auto;
      grid-template-columns: 1fr auto 1fr;
      padding-block: 0.3rem;
    }
  }

  .notebook-compare__divider-line {
    width: 2px;
    height: 100%;
    min-height: 1rem;
    background: repeating-linear-gradient(
      180deg,
      color-mix(in srgb, var(--site-ink-muted) 55%, transparent) 0,
      color-mix(in srgb, var(--site-ink-muted) 55%, transparent) 4px,
      transparent 4px,
      transparent 9px
    );
  }

  @media (max-width: 42rem) {
    .notebook-compare__divider-line {
      width: 100%;
      height: 2px;
      min-height: 0;
      background: repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--site-ink-muted) 55%, transparent) 0,
        color-mix(in srgb, var(--site-ink-muted) 55%, transparent) 4px,
        transparent 4px,
        transparent 9px
      );
    }
  }

  .notebook-compare__divider-badge {
    display: inline-grid;
    place-items: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.5rem;
    color: var(--notebook-sticker-lemon-ink);
    background: var(--notebook-sticker-lemon-bg);
    border-radius: 50% 48% 52% 46%;
    font-family: var(--notebook-font-hand);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transform: rotate(-3deg);
    box-shadow:
      0 0.2rem 0.35rem rgb(var(--notebook-shadow-rgb) / 0.16),
      inset 0 -0.14rem 0.24rem color-mix(in srgb, var(--notebook-sticker-lemon-ink) 22%, transparent);
  }
</style>
