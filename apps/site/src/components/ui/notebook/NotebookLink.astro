---
import CadLink from '@caderno-ui/astro/Link.astro'

type Tone = 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
type Props = {
  ariaLabel?: string
  class?: string
  external?: boolean
  href: string
  tone?: Tone
  variant?: 'highlight' | 'plain' | 'underline'
}

const {
  ariaLabel,
  class: className,
  external = false,
  href,
  tone = 'accent',
  variant = 'highlight',
}: Props = Astro.props
const cadernoTone = tone === 'accent' ? 'blue' : tone
---

<CadLink
  class:list={['notebook-link', className]}
  external={external}
  href={href}
  label={ariaLabel}
  tone={cadernoTone}
  variant={variant}
>
  <slot />
</CadLink>
