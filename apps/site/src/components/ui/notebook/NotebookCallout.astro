---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Variant = 'danger' | 'info' | 'success' | 'tip' | 'warn'

type Props = {
  class?: string
  icon?: NotebookDoodleName
  title?: string
  variant?: Variant
}

const {
  class: className,
  icon,
  title,
  variant = 'info',
} = Astro.props

const defaults: Record<Variant, { icon: NotebookDoodleName; label: string }> = {
  info: { icon: 'note', label: 'Nota' },
  tip: { icon: 'lightbulb', label: 'Dica' },
  success: { icon: 'check', label: 'Verificado' },
  warn: { icon: 'exclamation', label: 'Atenção' },
  danger: { icon: 'cross', label: 'Cuidado' },
}

const resolvedIcon = icon ?? defaults[variant].icon
const resolvedTitle = title ?? defaults[variant].label
---

<aside class:list={['notebook-callout', className]} data-variant={variant}>
  <span aria-hidden="true" class="notebook-callout__stripe"></span>
  <div class="notebook-callout__icon">
    <DoodleIcon name={resolvedIcon} size={22} />
  </div>
  <div class="notebook-callout__body">
    <p class="notebook-callout__title">{resolvedTitle}</p>
    <div class="notebook-callout__content"><slot /></div>
  </div>
</aside>

<style>
  .notebook-callout {
    --callout-ink: var(--notebook-post-it-blue-ink);
    --callout-tint: var(--notebook-post-it-blue-bg);
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1rem 1.15rem 1.1rem 1.35rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--callout-tint) 20%, var(--site-surface));
    border: 1.5px dashed color-mix(in srgb, var(--callout-ink) 35%, transparent);
    border-radius: 0.65rem 0.9rem 0.65rem 0.85rem;
  }

  .notebook-callout[data-variant='tip'] {
    --callout-ink: var(--notebook-post-it-lemon-ink);
    --callout-tint: var(--notebook-post-it-lemon-bg);
  }
  .notebook-callout[data-variant='success'] {
    --callout-ink: var(--notebook-post-it-mint-ink);
    --callout-tint: var(--notebook-post-it-mint-bg);
  }
  .notebook-callout[data-variant='warn'] {
    --callout-ink: var(--notebook-post-it-coral-ink);
    --callout-tint: var(--notebook-post-it-coral-bg);
  }
  .notebook-callout[data-variant='danger'] {
    --callout-ink: var(--notebook-post-it-pink-ink);
    --callout-tint: var(--notebook-post-it-pink-bg);
  }

  /* Faixa de marca-texto na borda esquerda */
  .notebook-callout__stripe {
    position: absolute;
    top: 0.7rem;
    bottom: 0.7rem;
    left: 0.5rem;
    width: 0.35rem;
    background: color-mix(in srgb, var(--callout-tint) 78%, transparent);
    border-radius: 0.2rem;
    box-shadow: inset 0 -0.14rem 0.2rem color-mix(in srgb, var(--callout-ink) 22%, transparent);
    transform: rotate(-0.6deg);
  }

  .notebook-callout__icon {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-top: 0.15rem;
    color: var(--callout-ink);
    background: color-mix(in srgb, var(--callout-tint) 55%, transparent);
    border-radius: 52% 48% 55% 45%;
    transform: rotate(-4deg);
    box-shadow: inset 0 -0.14rem 0.24rem color-mix(in srgb, var(--callout-ink) 22%, transparent);
  }

  .notebook-callout__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .notebook-callout__title {
    margin: 0;
    color: var(--callout-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .notebook-callout__content {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: 1rem;
    line-height: 1.6;
  }

  .notebook-callout__content :global(> :first-child) {
    margin-top: 0;
  }

  .notebook-callout__content :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
