---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import '@/styles/notebook-accordion.css'
import '@/styles/notebook-blockquote.css'
import '@/styles/notebook-code-block.css'
import '@/styles/notebook-highlight.css'
import '@/styles/notebook-post-it.css'
import '@/styles/notebook-table.css'

type Props = {
  class?: string
}

const { class: className }: Props = Astro.props
---

<div class:list={['article-prose', 'notebook-manual-prose', className]}>
  <slot />
</div>

<template data-notebook-accordion-indicator-template>
  <span aria-hidden="true" class="notebook-accordion-item__indicator">
    <DoodleIcon name="arrow-right" size={17} />
  </span>
</template>

<script>
  function setupNotebookManualAccordions() {
    const template = document.querySelector<HTMLTemplateElement>('[data-notebook-accordion-indicator-template]')
    const questions = document.querySelectorAll<HTMLDetailsElement>('.notebook-manual-prose .interview-question')

    questions.forEach((question) => {
      if (question.dataset.notebookAccordionItem === 'true') return

      question.classList.add('notebook-accordion-item')
      question.dataset.notebookAccordionItem = 'true'
      question.dataset.tone = 'accent'

      const summary = question.querySelector<HTMLElement>(':scope > summary')
      if (summary && !summary.querySelector('.notebook-accordion-item__tape')) {
        const title = document.createElement('span')
        title.append(...Array.from(summary.childNodes))

        const tape = document.createElement('span')
        tape.className = 'notebook-accordion-item__tape'
        tape.setAttribute('aria-hidden', 'true')

        summary.append(tape, title)
        if (template) summary.append(template.content.cloneNode(true))
      }

      let answer = question.querySelector<HTMLElement>(':scope > .interview-answer')
      if (!answer && summary) {
        answer = document.createElement('div')
        answer.className = 'interview-answer'
        const answerNodes = Array.from(question.childNodes).filter((node) => node !== summary)
        answer.append(...answerNodes)
        question.append(answer)
      }
      answer?.classList.add('notebook-accordion-item__content')
    })
  }

  function setupNotebookManualBlockquotes() {
    const quotes = document.querySelectorAll<HTMLQuoteElement>('.notebook-manual-prose blockquote')

    quotes.forEach((quote) => {
      if (quote.closest('.notebook-blockquote')) return

      const figure = document.createElement('figure')
      figure.className = 'notebook-blockquote'
      figure.dataset.tone = 'accent'

      const mark = document.createElement('span')
      mark.className = 'notebook-blockquote__mark'
      mark.setAttribute('aria-hidden', 'true')
      mark.textContent = '“'

      const body = document.createElement('div')
      body.append(...Array.from(quote.childNodes))
      quote.append(mark, body)
      quote.before(figure)
      figure.append(quote)
    })
  }

  function setupNotebookManualCodeBlocks() {
    const blocks = document.querySelectorAll<HTMLPreElement>('.notebook-manual-prose pre:not([data-mermaid-source]):not(.notebook-code-block__pre)')

    blocks.forEach((block) => {
      const figure = document.createElement('figure')
      figure.className = 'notebook-code-block'
      figure.dataset.tone = 'accent'

      block.classList.add('notebook-code-block__pre')
      block.dataset.lineNumbers = 'off'
      block.style.removeProperty('background-color')

      const code = block.querySelector<HTMLElement>(':scope > code')
      code?.classList.add('notebook-code-block__code')
      code?.querySelectorAll<HTMLElement>(':scope > .line').forEach((line) => {
        line.classList.add('notebook-code-block__line')
      })

      block.before(figure)
      figure.append(block)
    })
  }

  function setupNotebookManualHighlights() {
    const highlights = document.querySelectorAll<HTMLElement>('.notebook-manual-prose mark, .notebook-manual-prose .book-marker')

    highlights.forEach((highlight) => {
      highlight.classList.add('notebook-highlight')
      highlight.dataset.tone = highlight.dataset.tone ?? 'yellow'
      highlight.dataset.variant = highlight.dataset.variant ?? 'marker'
    })
  }

  function setupNotebookManualTables() {
    const tables = document.querySelectorAll<HTMLTableElement>('.notebook-manual-prose table')

    tables.forEach((table) => {
      if (table.closest('.notebook-table-wrap')) return

      const wrapper = document.createElement('div')
      wrapper.className = 'notebook-table-wrap'
      wrapper.dataset.zebra = 'false'
      table.classList.add('notebook-table')
      table.before(wrapper)
      wrapper.append(table)
    })
  }

  setupNotebookManualBlockquotes()
  setupNotebookManualCodeBlocks()
  setupNotebookManualHighlights()
  setupNotebookManualAccordions()
  setupNotebookManualTables()
  document.addEventListener('astro:page-load', setupNotebookManualBlockquotes)
  document.addEventListener('astro:page-load', setupNotebookManualCodeBlocks)
  document.addEventListener('astro:page-load', setupNotebookManualHighlights)
  document.addEventListener('astro:page-load', setupNotebookManualAccordions)
  document.addEventListener('astro:page-load', setupNotebookManualTables)
</script>

<style>
  .notebook-manual-prose {
    margin-inline: 0;
    max-width: none;
  }

  :global(.notebook-manual-prose > :first-child) {
    margin-top: 0;
  }

  :global(.notebook-manual-prose > h2) {
    position: relative;
    margin-top: 3.8rem;
    margin-bottom: 0.85rem;
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: clamp(1.75rem, 2.6vw, 2.15rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  :global(.notebook-manual-prose > h2::before) {
    position: absolute;
    top: -0.75rem;
    left: 0.05rem;
    width: 3.6rem;
    height: 0.42rem;
    background: color-mix(in srgb, var(--notebook-post-it-blue-bg) 72%, transparent);
    border-radius: 0.12rem;
    content: '';
    transform: rotate(-0.25deg);
  }

  :global(.notebook-manual-prose > h3) {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  :global(.notebook-manual-prose .notebook-accordion-item) {
    margin-block: 0.75rem;
  }

  :global(.notebook-manual-prose .notebook-blockquote),
  :global(.notebook-manual-prose .notebook-code-block),
  :global(.notebook-manual-prose .notebook-table-wrap) {
    margin-block: 1.75rem 2rem;
  }

  :global(.notebook-manual-prose .book-sketch-note) {
    position: relative;
    margin-block: 2rem 2.5rem;
    padding: 1.05rem 1.2rem 1rem 1.35rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--notebook-post-it-blue-bg) 15%, var(--site-surface));
    border: 1.5px dashed color-mix(in srgb, var(--notebook-post-it-blue-ink) 32%, transparent);
    border-radius: 0.65rem 0.9rem 0.65rem 0.85rem;
  }

  :global(.notebook-manual-prose .book-sketch-note p) {
    margin: 0;
  }

  :global(.notebook-manual-prose .book-sketch-note__label) {
    margin-bottom: 0.35rem;
    color: var(--notebook-post-it-blue-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.notebook-manual-prose .notebook-post-it) {
    margin: 2.25rem 0 2.75rem auto;
  }

  :global(.notebook-manual-prose .book-pencil-note) {
    display: flex;
    width: fit-content;
    max-width: min(100%, 18rem);
    align-items: center;
    gap: 0.45rem;
    margin-block: -0.25rem 1.75rem;
    color: var(--book-pencil);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.4;
    transform: rotate(-0.35deg);
  }

  :global(.notebook-manual-prose .book-pencil-note--right) {
    margin-left: auto;
  }

  :global(.notebook-manual-prose .book-pencil-note--bracket) {
    display: block;
    max-width: 15rem;
    margin-left: auto;
    padding-right: 0.6rem;
    text-align: right;
  }

  :global(.notebook-manual-prose [data-sketch-arrow-canvas]) {
    width: 3.6rem;
    height: 1.75rem;
    flex: 0 0 auto;
    overflow: visible;
  }

  :global(.notebook-manual-prose [data-sketch-annotation='underline']) {
    color: var(--article-heading-color);
    font-weight: 650;
    white-space: nowrap;
  }

  :global(.notebook-manual-prose [data-sketch-annotation='circle']) {
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    :global(.notebook-manual-prose .notebook-post-it) {
      width: calc(100% - 0.75rem);
      margin-right: auto;
    }

    :global(.notebook-manual-prose .book-pencil-note) {
      max-width: 15rem;
      margin-top: 0.25rem;
    }
  }

</style>
