---
import '@caderno-ui/elements/prose.css'

type Props = {
  class?: string
}

const { class: className }: Props = Astro.props
---

<div class:list={['article-prose', 'cad-prose', className]}>
  <slot />
</div>

<script>
  import { installCadernoProse } from '@caderno-ui/elements/prose'

  installCadernoProse()
</script>
