---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Item = {
  hint?: string
  icon: NotebookDoodleName
  label: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  class?: string
  columns?: 2 | 3 | 4 | 5
  items: Item[]
}

const {
  class: className,
  columns = 4,
  items,
} = Astro.props
---

<ul class:list={['notebook-benefit-grid', className]} data-columns={columns}>
  {items.map((item) => (
    <li class="notebook-benefit-grid__item" data-tone={item.tone ?? 'blue'}>
      <span class="notebook-benefit-grid__icon">
        <DoodleIcon name={item.icon} size={32} />
      </span>
      <p class="notebook-benefit-grid__label">{item.label}</p>
      {item.hint ? <p class="notebook-benefit-grid__hint">{item.hint}</p> : null}
    </li>
  ))}
</ul>

<style>
  .notebook-benefit-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notebook-benefit-grid[data-columns='2'] { --cols: 2; }
  .notebook-benefit-grid[data-columns='3'] { --cols: 3; }
  .notebook-benefit-grid[data-columns='4'] { --cols: 4; }
  .notebook-benefit-grid[data-columns='5'] { --cols: 5; }

  @media (max-width: 48rem) {
    .notebook-benefit-grid[data-columns='4'],
    .notebook-benefit-grid[data-columns='5'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 32rem) {
    .notebook-benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  .notebook-benefit-grid__item {
    --tile-bg: var(--notebook-post-it-blue-bg);
    --tile-ink: var(--notebook-post-it-blue-ink);
    display: grid;
    gap: 0.35rem;
    padding: 0.95rem 0.7rem 0.9rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--tile-bg) 32%, var(--site-surface));
    border: 1.5px dashed color-mix(in srgb, var(--tile-ink) 36%, transparent);
    border-radius: 0.7rem 0.9rem 0.7rem 0.85rem;
    text-align: center;
  }

  .notebook-benefit-grid__item[data-tone='coral'] {
    --tile-bg: var(--notebook-post-it-coral-bg);
    --tile-ink: var(--notebook-post-it-coral-ink);
  }
  .notebook-benefit-grid__item[data-tone='mint'] {
    --tile-bg: var(--notebook-post-it-mint-bg);
    --tile-ink: var(--notebook-post-it-mint-ink);
  }
  .notebook-benefit-grid__item[data-tone='lemon'] {
    --tile-bg: var(--notebook-post-it-lemon-bg);
    --tile-ink: var(--notebook-post-it-lemon-ink);
  }
  .notebook-benefit-grid__item[data-tone='pink'] {
    --tile-bg: var(--notebook-post-it-pink-bg);
    --tile-ink: var(--notebook-post-it-pink-ink);
  }
  .notebook-benefit-grid__item[data-tone='violet'] {
    --tile-bg: var(--notebook-sticker-violet-bg);
    --tile-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-benefit-grid__icon {
    display: inline-grid;
    place-items: center;
    justify-self: center;
    width: 3rem;
    height: 3rem;
    color: var(--tile-ink);
    background: color-mix(in srgb, var(--tile-bg) 70%, var(--site-surface));
    border-radius: 50% 46% 52% 48%;
    box-shadow: inset 0 -0.14rem 0.28rem color-mix(in srgb, var(--tile-ink) 20%, transparent);
  }

  .notebook-benefit-grid__label {
    margin: 0;
    color: var(--tile-ink);
    font-family: var(--notebook-font-hand);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .notebook-benefit-grid__hint {
    margin: 0;
    color: var(--site-ink-soft);
    font-size: 0.76rem;
    line-height: 1.35;
  }
</style>
