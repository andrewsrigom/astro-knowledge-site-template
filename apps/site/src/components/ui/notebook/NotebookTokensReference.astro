---
type Props = {
  class?: string
  locale?: string
}

const {
  class: className,
  locale = 'pt-br',
}: Props = Astro.props

const isPortuguese = locale === 'pt-br'

const typographyTokens = [
  { token: '--notebook-font-book', sample: 'O mecanismo antes da receita', role: isPortuguese ? 'Texto e títulos do livro' : 'Book copy and headings' },
  { token: '--notebook-font-hand', sample: 'lembre de validar o limite', role: isPortuguese ? 'Anotações e rótulos' : 'Notes and labels' },
  { token: '--notebook-font-mono', sample: 'const result = verify(input)', role: isPortuguese ? 'Código e valores técnicos' : 'Code and technical values' },
]

const handScaleTokens = [
  '--notebook-hand-xs',
  '--notebook-hand-sm',
  '--notebook-hand-md',
  '--notebook-hand-lg',
  '--notebook-hand-xl',
  '--notebook-hand-2xl',
]

const colorGroups = [
  {
    title: isPortuguese ? 'Adesivos' : 'Stickers',
    tokens: ['blue', 'coral', 'lemon', 'mint', 'violet'].map((tone) => ({
      background: `--notebook-sticker-${tone}-bg`,
      foreground: `--notebook-sticker-${tone}-ink`,
      name: tone,
    })),
  },
  {
    title: 'Post-its',
    tokens: ['lemon', 'pink', 'mint', 'blue', 'coral'].map((tone) => ({
      background: `--notebook-post-it-${tone}-bg`,
      foreground: `--notebook-post-it-${tone}-ink`,
      name: tone,
    })),
  },
]

const highlightTokens = ['yellow', 'pink', 'green', 'blue', 'orange', 'violet'].map((tone) => ({
  name: tone,
  token: `--notebook-highlight-${tone}`,
}))
---

<div class:list={['notebook-tokens-reference', className]}>
  <section class="notebook-tokens-reference__section" aria-labelledby="token-typography">
    <header class="notebook-tokens-reference__header">
      <p>{isPortuguese ? 'Fundação' : 'Foundation'}</p>
      <h2 id="token-typography">{isPortuguese ? 'Três vozes tipográficas' : 'Three typographic voices'}</h2>
    </header>

    <div class="notebook-tokens-reference__type-grid">
      {typographyTokens.map((item, index) => (
        <article class="notebook-tokens-reference__type-card" data-font={index === 0 ? 'book' : index === 1 ? 'hand' : 'mono'}>
          <code>{item.token}</code>
          <p class="notebook-tokens-reference__sample">{item.sample}</p>
          <p class="notebook-tokens-reference__role">{item.role}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="notebook-tokens-reference__section" aria-labelledby="token-hand-scale">
    <header class="notebook-tokens-reference__header">
      <p>{isPortuguese ? 'Escala' : 'Scale'}</p>
      <h2 id="token-hand-scale">{isPortuguese ? 'Anotação manuscrita' : 'Handwritten notes'}</h2>
    </header>

    <div class="notebook-tokens-reference__scale-list">
      {handScaleTokens.map((token, index) => (
        <div class="notebook-tokens-reference__scale-item">
          <code>{token}</code>
          <span style={`font-size: var(${token})`}>{isPortuguese ? `Nível ${index + 1}` : `Level ${index + 1}`}</span>
        </div>
      ))}
    </div>
  </section>

  {colorGroups.map((group, index) => (
    <section class="notebook-tokens-reference__section" aria-labelledby={`token-colors-${index}`}>
      <header class="notebook-tokens-reference__header">
        <p>{isPortuguese ? 'Cor semântica' : 'Semantic color'}</p>
        <h2 id={`token-colors-${index}`}>{group.title}</h2>
      </header>

      <div class="notebook-tokens-reference__swatch-grid">
        {group.tokens.map((item) => (
          <article
            class="notebook-tokens-reference__swatch"
            style={`--swatch-bg: var(${item.background}); --swatch-ink: var(${item.foreground})`}
          >
            <strong>{item.name}</strong>
            <code>{item.background}</code>
            <code>{item.foreground}</code>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="notebook-tokens-reference__section" aria-labelledby="token-highlights">
    <header class="notebook-tokens-reference__header">
      <p>{isPortuguese ? 'Ênfase' : 'Emphasis'}</p>
      <h2 id="token-highlights">Marca-textos</h2>
    </header>

    <div class="notebook-tokens-reference__highlight-grid">
      {highlightTokens.map((item) => (
        <article class="notebook-tokens-reference__highlight">
          <span style={`--highlight: var(${item.token})`}>{isPortuguese ? 'Trecho importante' : 'Important passage'}</span>
          <code>{item.token}</code>
        </article>
      ))}
    </div>
  </section>

  <section class="notebook-tokens-reference__section" aria-labelledby="token-rules">
    <header class="notebook-tokens-reference__header">
      <p>{isPortuguese ? 'Uso' : 'Usage'}</p>
      <h2 id="token-rules">{isPortuguese ? 'Regras de composição' : 'Composition rules'}</h2>
    </header>

    <ul class="notebook-tokens-reference__rules">
      <li>{isPortuguese ? 'Texto técnico usa a voz do livro; anotações curtas usam a voz manuscrita.' : 'Technical copy uses the book voice; short notes use the handwritten voice.'}</li>
      <li>{isPortuguese ? 'Adesivos inclinam no máximo 0,5° e post-its, 0,4°. Cartões permanecem retos.' : 'Stickers tilt by at most 0.5° and post-its by 0.4°. Cards remain straight.'}</li>
      <li>{isPortuguese ? 'O tema escolhe os valores. Componentes consomem tokens, nunca cores duplicadas.' : 'The theme chooses values. Components consume tokens instead of duplicating colors.'}</li>
      <li>{isPortuguese ? 'Estados de foco usam outline tracejado de 2 px com afastamento de 3 px.' : 'Focus states use a 2 px dashed outline with a 3 px offset.'}</li>
    </ul>
  </section>
</div>

<style>
  .notebook-tokens-reference {
    display: grid;
    gap: 3.5rem;
  }

  .notebook-tokens-reference__section {
    display: grid;
    gap: 1.25rem;
  }

  .notebook-tokens-reference__header {
    display: grid;
    gap: 0.2rem;
  }

  .notebook-tokens-reference__header p,
  .notebook-tokens-reference__header h2 {
    margin: 0;
  }

  .notebook-tokens-reference__header p {
    color: var(--site-link-hover);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-tokens-reference__header h2 {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .notebook-tokens-reference__type-grid,
  .notebook-tokens-reference__swatch-grid,
  .notebook-tokens-reference__highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
  }

  .notebook-tokens-reference__type-card,
  .notebook-tokens-reference__swatch,
  .notebook-tokens-reference__highlight {
    min-width: 0;
    padding: 1.1rem;
    border: 1px dashed var(--site-line-strong);
    border-radius: 0.65rem;
    background: var(--site-surface);
  }

  .notebook-tokens-reference__type-card code,
  .notebook-tokens-reference__swatch code,
  .notebook-tokens-reference__highlight code,
  .notebook-tokens-reference__scale-item code {
    overflow-wrap: anywhere;
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-mono);
    font-size: 0.72rem;
  }

  .notebook-tokens-reference__sample {
    margin: 1rem 0 0;
    color: var(--site-ink);
  }

  .notebook-tokens-reference__type-card[data-font='book'] .notebook-tokens-reference__sample {
    font-family: var(--notebook-font-book);
    font-size: 1.35rem;
  }

  .notebook-tokens-reference__type-card[data-font='hand'] .notebook-tokens-reference__sample {
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: var(--notebook-hand-weight-regular);
  }

  .notebook-tokens-reference__type-card[data-font='mono'] .notebook-tokens-reference__sample {
    font-family: var(--notebook-font-mono);
    font-size: 0.9rem;
  }

  .notebook-tokens-reference__role {
    margin: 0.7rem 0 0;
    color: var(--site-ink-soft);
    font-size: 0.88rem;
  }

  .notebook-tokens-reference__scale-list {
    display: grid;
    gap: 0;
    border-block: 1px dashed var(--site-line-strong);
  }

  .notebook-tokens-reference__scale-item {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 1fr;
    align-items: baseline;
    gap: 1rem;
    min-width: 0;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--site-line);
  }

  .notebook-tokens-reference__scale-item:last-child {
    border-bottom: 0;
  }

  .notebook-tokens-reference__scale-item span {
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-weight: var(--notebook-hand-weight-regular);
  }

  .notebook-tokens-reference__swatch {
    display: grid;
    gap: 0.3rem;
    color: var(--swatch-ink);
    background: var(--swatch-bg);
    border-color: color-mix(in srgb, var(--swatch-ink) 34%, transparent);
  }

  .notebook-tokens-reference__swatch strong {
    margin-bottom: 0.55rem;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-tokens-reference__swatch code {
    color: inherit;
    opacity: 0.82;
  }

  .notebook-tokens-reference__highlight {
    display: grid;
    gap: 0.8rem;
  }

  .notebook-tokens-reference__highlight span {
    width: fit-content;
    padding-inline: 0.18rem;
    color: var(--site-ink);
    background: linear-gradient(transparent 48%, var(--highlight) 48% 88%, transparent 88%);
    font-family: var(--notebook-font-book);
    font-size: 1.02rem;
  }

  .notebook-tokens-reference__rules {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 1.2rem 1.2rem 1.2rem 2.4rem;
    color: var(--site-ink-soft);
    background: color-mix(in srgb, var(--notebook-post-it-blue-bg) 22%, var(--site-surface));
    border-left: 0.28rem solid var(--notebook-post-it-blue-ink);
    font-family: var(--notebook-font-book);
    line-height: 1.6;
  }

  @media (max-width: 40rem) {
    .notebook-tokens-reference__scale-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
