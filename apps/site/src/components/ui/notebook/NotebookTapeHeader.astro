---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  align?: 'center' | 'left'
  class?: string
  icon?: NotebookDoodleName
  kicker?: string
  size?: 'lg' | 'md'
  title: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

const {
  align = 'left',
  class: className,
  icon,
  kicker,
  size = 'md',
  title,
  tone = 'lemon',
} = Astro.props
---

<header class:list={['notebook-tape-header', className]} data-align={align} data-size={size} data-tone={tone}>
  <div class="notebook-tape-header__content">
    {kicker ? (
      <p class="notebook-tape-header__kicker">
        {icon ? <DoodleIcon name={icon} size={16} /> : null}
        <span>{kicker}</span>
      </p>
    ) : null}
    <h2 class="notebook-tape-header__title">{title}</h2>
    <slot />
  </div>
</header>

<style>
  .notebook-tape-header {
    --tape-ink: var(--notebook-post-it-lemon-ink);
    --tape-bg: var(--notebook-post-it-lemon-bg);
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.55rem;
    padding-block: 1.1rem 0.35rem;
  }

  .notebook-tape-header[data-align='center'] {
    justify-items: center;
    text-align: center;
  }

  .notebook-tape-header[data-tone='pink'] {
    --tape-ink: var(--notebook-post-it-pink-ink);
    --tape-bg: var(--notebook-post-it-pink-bg);
  }

  .notebook-tape-header[data-tone='mint'] {
    --tape-ink: var(--notebook-post-it-mint-ink);
    --tape-bg: var(--notebook-post-it-mint-bg);
  }

  .notebook-tape-header[data-tone='blue'] {
    --tape-ink: var(--notebook-post-it-blue-ink);
    --tape-bg: var(--notebook-post-it-blue-bg);
  }

  .notebook-tape-header[data-tone='coral'] {
    --tape-ink: var(--notebook-post-it-coral-ink);
    --tape-bg: var(--notebook-post-it-coral-bg);
  }

  .notebook-tape-header[data-tone='violet'] {
    --tape-ink: var(--notebook-sticker-violet-ink);
    --tape-bg: var(--notebook-sticker-violet-bg);
  }

  .notebook-tape-header__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    padding-top: 0;
  }

  .notebook-tape-header[data-align='center'] .notebook-tape-header__content {
    justify-items: center;
  }

  .notebook-tape-header__kicker {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.4rem;
    margin: 0;
    padding: 0.22rem 0.62rem 0.26rem;
    color: var(--tape-ink);
    background: color-mix(in srgb, var(--tape-bg) 62%, transparent);
    border-radius: 0.25rem;
    font-family: var(--notebook-font-hand);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    width: fit-content;
    max-width: 100%;
  }

  .notebook-tape-header[data-align='center'] .notebook-tape-header__kicker {
    justify-self: center;
  }

  .notebook-tape-header__title {
    margin: 0;
    font-family: var(--notebook-font-book);
    font-weight: 700;
    line-height: 1.02;
    color: var(--site-ink);
    letter-spacing: -0.02em;
  }

  .notebook-tape-header[data-size='md'] .notebook-tape-header__title {
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
  }

  .notebook-tape-header[data-size='lg'] .notebook-tape-header__title {
    font-size: clamp(2.1rem, 4vw, 3.1rem);
  }
</style>
