---
import NotebookTape from '@/components/ui/notebook/NotebookTape.astro'

type Props = {
  class?: string
  code?: string
  filename?: string
  language?: string
  showLineNumbers?: boolean
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

const {
  class: className,
  code,
  filename,
  language,
  showLineNumbers = false,
  tone = 'accent',
} = Astro.props

const rawCode = code ?? ''
const lines = rawCode.length ? rawCode.replace(/\n$/, '').split('\n') : null
---

<figure class:list={['notebook-code-block', className]} data-tone={tone}>
  {(language || filename) ? (
    <div class="notebook-code-block__ribbon">
      <NotebookTape tone={tone === 'accent' ? 'blue' : tone} tilt={-1.2} width="md" />
      <span class="notebook-code-block__ribbon-text">
        {filename ? <span class="notebook-code-block__filename">{filename}</span> : null}
        {language ? <span class="notebook-code-block__language">{language}</span> : null}
      </span>
    </div>
  ) : null}

  <pre class="notebook-code-block__pre" data-line-numbers={showLineNumbers ? 'on' : 'off'}><code class="notebook-code-block__code">{lines ? (
      lines.map((line, index) => (
        <span class="notebook-code-block__line">
          {showLineNumbers ? <span aria-hidden="true" class="notebook-code-block__ln">{index + 1}</span> : null}
          <span class="notebook-code-block__line-text">{line || '\u00a0'}</span>
        </span>
      ))
    ) : (
      <slot />
    )}</code></pre>
</figure>

<style>
  .notebook-code-block {
    --code-ink: var(--notebook-post-it-blue-ink);
    --code-bg: color-mix(in srgb, var(--site-surface-strong) 82%, var(--site-bg));
    position: relative;
    display: block;
    margin: 0;
    padding: 0;
    background: var(--code-bg);
    border: 1.5px dashed color-mix(in srgb, var(--code-ink) 32%, transparent);
    border-radius: 0.7rem 0.9rem 0.7rem 0.85rem;
    box-shadow: 0 0.55rem 1.1rem rgb(var(--notebook-shadow-rgb) / 0.14);
    overflow: hidden;
  }

  .notebook-code-block[data-tone='coral'] { --code-ink: var(--notebook-post-it-coral-ink); }
  .notebook-code-block[data-tone='mint'] { --code-ink: var(--notebook-post-it-mint-ink); }
  .notebook-code-block[data-tone='lemon'] { --code-ink: var(--notebook-post-it-lemon-ink); }
  .notebook-code-block[data-tone='pink'] { --code-ink: var(--notebook-post-it-pink-ink); }
  .notebook-code-block[data-tone='violet'] { --code-ink: var(--notebook-sticker-violet-ink); }

  .notebook-code-block__ribbon {
    position: absolute;
    top: -0.55rem;
    right: 1.2rem;
    display: inline-grid;
    place-items: center;
    line-height: 0;
    z-index: 2;
  }

  .notebook-code-block__ribbon-text {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--code-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    transform: rotate(-1.2deg);
    pointer-events: none;
  }

  .notebook-code-block__filename {
    text-transform: none;
    letter-spacing: 0.02em;
    font-family: var(--notebook-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .notebook-code-block__pre {
    margin: 0;
    padding: 1.1rem 1.25rem 1.15rem;
    background: transparent;
    color: color-mix(in srgb, var(--site-ink-bright, var(--site-ink)) 92%, transparent);
    font-family: var(--notebook-font-mono);
    font-size: 0.92rem;
    line-height: 1.6;
    overflow-x: auto;
    tab-size: 2;
  }

  .notebook-code-block__code {
    display: grid;
    gap: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  .notebook-code-block__line {
    display: grid;
    grid-template-columns: 1fr;
    align-items: baseline;
    white-space: pre;
  }

  .notebook-code-block__pre[data-line-numbers='on'] .notebook-code-block__line {
    grid-template-columns: 2.4rem 1fr;
    gap: 0.75rem;
  }

  .notebook-code-block__ln {
    color: color-mix(in srgb, var(--site-ink-muted) 78%, transparent);
    font-size: 0.78rem;
    text-align: right;
    user-select: none;
  }

  .notebook-code-block__line-text {
    display: inline;
    white-space: pre;
  }
</style>
