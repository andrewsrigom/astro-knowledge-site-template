---
type Props = {
  class?: string
  tilt?: number
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'paper' | 'pink' | 'violet'
  width?: 'lg' | 'md' | 'sm'
}

const {
  class: className,
  tilt = -1.4,
  tone = 'lemon',
  width = 'md',
} = Astro.props
---

<span
  aria-hidden="true"
  class:list={['notebook-tape', className]}
  data-tone={tone}
  data-width={width}
  style={`--notebook-tape-tilt: ${tilt}deg;`}
></span>

<style>
  .notebook-tape {
    --tape-bg: var(--notebook-post-it-lemon-bg);
    display: inline-block;
    width: 5.4rem;
    height: 1.55rem;
    background: color-mix(in srgb, var(--tape-bg) 82%, transparent);
    filter: drop-shadow(0 0.16rem 0.24rem rgb(var(--notebook-shadow-rgb) / 0.14));
    transform: rotate(var(--notebook-tape-tilt, -1.4deg));
    /* Onda irregular nas bordas superior e inferior */
    clip-path: polygon(
      0 12%, 6% 0, 14% 22%, 24% 4%, 34% 18%, 46% 6%, 58% 20%, 70% 8%, 82% 22%, 94% 6%, 100% 18%,
      100% 82%, 94% 100%, 82% 78%, 70% 92%, 58% 80%, 46% 94%, 34% 82%, 24% 96%, 14% 78%, 6% 100%, 0 88%
    );
  }

  .notebook-tape[data-width='sm'] {
    width: 3.4rem;
    height: 1.15rem;
  }

  .notebook-tape[data-width='lg'] {
    width: 7.6rem;
    height: 1.85rem;
  }

  .notebook-tape[data-tone='pink'] {
    --tape-bg: var(--notebook-post-it-pink-bg);
  }

  .notebook-tape[data-tone='mint'] {
    --tape-bg: var(--notebook-post-it-mint-bg);
  }

  .notebook-tape[data-tone='blue'] {
    --tape-bg: var(--notebook-post-it-blue-bg);
  }

  .notebook-tape[data-tone='coral'] {
    --tape-bg: var(--notebook-post-it-coral-bg);
  }

  .notebook-tape[data-tone='violet'] {
    --tape-bg: var(--notebook-sticker-violet-bg);
  }

  .notebook-tape[data-tone='paper'] {
    --tape-bg: var(--notebook-tape-paper-bg);
  }
</style>
