---
import NotebookAccordion from '@/components/ui/notebook/NotebookAccordion.astro'
import NotebookAccordionItem from '@/components/ui/notebook/NotebookAccordionItem.astro'
import NotebookAvatar from '@/components/ui/notebook/NotebookAvatar.astro'
import NotebookBlockquote from '@/components/ui/notebook/NotebookBlockquote.astro'
import NotebookDoDont from '@/components/ui/notebook/NotebookDoDont.astro'
import NotebookKanban from '@/components/ui/notebook/NotebookKanban.astro'
import NotebookRuledTable from '@/components/ui/notebook/NotebookRuledTable.astro'
import NotebookTable from '@/components/ui/notebook/NotebookTable.astro'
import NotebookTimeBlock from '@/components/ui/notebook/NotebookTimeBlock.astro'

const comparisonColumns = [
  { key: 'tool', label: 'Estrutura' },
  { key: 'lookup', label: 'Busca' },
  { key: 'insert', label: 'Inserção' },
  { key: 'use', label: 'Quando usar' },
]
const comparisonRows = [
  { tool: 'Array', lookup: 'O(1) por índice', insert: 'O(n) no meio', use: 'Ordem e acesso posicional' },
  { tool: 'Map', lookup: 'O(1) médio', insert: 'O(1) médio', use: 'Busca por chave' },
  { tool: 'Set', lookup: 'O(1) médio', insert: 'O(1) médio', use: 'Unicidade e presença' },
]
---

<div class="notebook-content-showcase">
  <section class="notebook-content-section" aria-labelledby="content-accordion-title">
    <header>
      <p>Conteúdo expansível</p>
      <h2 id="content-accordion-title">Perguntas e respostas</h2>
      <span>O título permanece visível; a resposta só ocupa espaço quando é necessária.</span>
    </header>
    <NotebookAccordion groupId="interview-questions" mode="single">
      <NotebookAccordionItem open title="Por que Map costuma substituir uma busca aninhada?" tone="accent">
        <p>Porque transforma uma busca repetida em acesso por chave. O custo esperado cai de O(n²) para O(n), ao preço de memória adicional.</p>
      </NotebookAccordionItem>
      <NotebookAccordionItem title="Quando a solução simples é melhor?" tone="mint">
        <p>Quando atende ao contrato, deixa os casos de borda claros e evita uma abstração que ainda não tem mais de um uso real.</p>
      </NotebookAccordionItem>
      <NotebookAccordionItem title="O que explicar durante o live coding?" tone="lemon">
        <p>Contrato, estrutura escolhida, invariante, custo esperado e como os testes protegem os limites da solução.</p>
      </NotebookAccordionItem>
    </NotebookAccordion>
  </section>

  <section class="notebook-content-section" aria-labelledby="content-tables-title">
    <header>
      <p>Dados</p>
      <h2 id="content-tables-title">Tabelas para consulta</h2>
      <span>A tabela completa organiza comparação; a versão pautada mantém listas curtas leves.</span>
    </header>
    <div class="notebook-content-table-stack">
      <NotebookTable caption="Custos esperados" columns={comparisonColumns} rows={comparisonRows} zebra />
      <NotebookRuledTable
        caption="Sinais de diagnóstico"
        columns={[
          { key: 'signal', label: 'Sinal' },
          { key: 'check', label: 'Primeira verificação' },
        ]}
        rows={[
          { signal: 'CPU alta', check: 'Perfil de execução e trabalho síncrono' },
          { signal: 'p99 alto', check: 'Dependências lentas, filas e saturação' },
          { signal: 'Memória crescente', check: 'Retenção, caches e listeners' },
        ]}
      />
    </div>
  </section>

  <section class="notebook-content-section" aria-labelledby="content-guidance-title">
    <header>
      <p>Orientação</p>
      <h2 id="content-guidance-title">Faça e não faça</h2>
      <span>Contrastes práticos ficam separados de checklists ou alertas.</span>
    </header>
    <NotebookDoDont
      do={[
        'Defina o contrato antes de codificar.',
        'Explique a escolha da estrutura de dados.',
        'Teste limites e entradas inválidas.',
      ]}
      dont={[
        'Comece por uma abstração genérica.',
        'Otimize sem conhecer o gargalo.',
        'Esconda mutações importantes.',
      ]}
    />
  </section>

  <section class="notebook-content-section" aria-labelledby="content-planning-title">
    <header>
      <p>Planejamento</p>
      <h2 id="content-planning-title">Quadro e agenda</h2>
      <span>Post-its organizam estado; blocos de tempo deixam o plano executável.</span>
    </header>
    <div class="notebook-content-planning-stack">
      <NotebookKanban
        columns={[
          { id: 'backlog', title: 'Revisar', cards: [
            { label: 'Event loop e microtasks', tone: 'lemon' },
            { label: 'Índices compostos', tone: 'pink' },
          ] },
          { id: 'wip', title: 'Em estudo', cards: [
            { label: 'Promises e cancelamento', tone: 'blue' },
          ] },
          { id: 'done', title: 'Revisado', cards: [
            { label: 'Objetos e prototypes', tone: 'mint' },
          ] },
        ]}
      />
      <NotebookTimeBlock
        columns={['Segunda', 'Terça', 'Quarta']}
        startHour={8}
        endHour={14}
        blocks={[
          { column: 1, start: '08:30', end: '10:00', label: 'JavaScript', tone: 'blue' },
          { column: 2, start: '09:00', end: '11:00', label: 'Backend', tone: 'mint' },
          { column: 3, start: '11:30', end: '13:00', label: 'System Design', tone: 'lemon' },
        ]}
      />
    </div>
  </section>

  <section class="notebook-content-section" aria-labelledby="content-voice-title">
    <header>
      <p>Referência e autoria</p>
      <h2 id="content-voice-title">Citação e avatar</h2>
      <span>A fonte fica explícita e a anotação pode indicar quem adicionou o contexto.</span>
    </header>
    <div class="notebook-content-voice-grid">
      <NotebookBlockquote author="Edsger W. Dijkstra" source="The Humble Programmer" tone="violet">
        <p>A simplicidade de uma solução precisa ser demonstrada na estrutura, não apenas afirmada na explicação.</p>
      </NotebookBlockquote>
      <div class="notebook-content-avatar-stack">
        <NotebookAvatar badge="online" name="André Silva" role="Autor da anotação" size="lg" />
        <NotebookAvatar badge="away" name="SeniorPath" role="Revisão editorial" />
      </div>
    </div>
  </section>
</div>

<style>
  .notebook-content-showcase {
    display: grid;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .notebook-content-section {
    display: grid;
    gap: 1.4rem;
  }

  .notebook-content-section > header {
    display: grid;
    gap: 0.3rem;
  }

  .notebook-content-section > header p,
  .notebook-content-section > header h2,
  .notebook-content-section > header span {
    margin: 0;
  }

  .notebook-content-section > header p {
    color: var(--site-link-hover);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notebook-content-section > header h2 {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
  }

  .notebook-content-section > header span {
    color: var(--site-ink-muted);
  }

  .notebook-content-table-stack,
  .notebook-content-planning-stack,
  .notebook-content-avatar-stack {
    display: grid;
    gap: 1.25rem;
  }

  .notebook-content-voice-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.7fr);
    gap: 1rem;
    align-items: start;
  }

  .notebook-content-avatar-stack {
    padding: 1.25rem;
    background: color-mix(in srgb, var(--site-surface) 90%, transparent);
    border: 1px solid var(--site-line);
    border-radius: 0.8rem 1rem 0.75rem 0.95rem;
  }

  @media (max-width: 44rem) {
    .notebook-content-voice-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
