---
import CadBookmark from '@caderno-ui/astro/Bookmark.astro'

type Props = {
  activeLabel?: string
  bookmarked?: boolean
  class?: string
  id: string
  label: string
  persist?: boolean
}

const {
  activeLabel = 'Remover marcador',
  bookmarked = false,
  class: className,
  id,
  label,
  persist = false,
} = Astro.props
---

<CadBookmark
  activeLabel={activeLabel}
  bookmarked={bookmarked}
  class={className}
  id={id}
  label={label}
  persist={persist}
  storagePrefix="seniorpath:notebook-bookmark"
/>
