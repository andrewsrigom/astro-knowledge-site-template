---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Variant = 'error' | 'info' | 'success' | 'warning'

type Props = {
  class?: string
  closeLabel?: string
  duration?: number
  title?: string
  variant?: Variant
}

const {
  class: className,
  closeLabel = 'Fechar notificação',
  duration = 0,
  title,
  variant = 'info',
}: Props = Astro.props

const icons: Record<Variant, NotebookDoodleName> = {
  error: 'bug',
  info: 'spark',
  success: 'check',
  warning: 'exclamation',
}
---

<article
  class:list={['notebook-toast', className]}
  data-duration={Math.max(0, duration)}
  data-variant={variant}
  role={variant === 'error' ? 'alert' : 'status'}
>
  <span aria-hidden="true" class="notebook-toast__tape"></span>
  <span aria-hidden="true" class="notebook-toast__icon">
    <DoodleIcon name={icons[variant]} size={20} />
  </span>
  <div class="notebook-toast__body">
    {title ? <strong class="notebook-toast__title">{title}</strong> : null}
    <div class="notebook-toast__content"><slot /></div>
  </div>
  <button aria-label={closeLabel} class="notebook-toast__close" type="button">
    <DoodleIcon name="cross" size={16} />
  </button>
</article>

<script>
  function setupStandaloneNotebookToasts() {
    const toasts = document.querySelectorAll<HTMLElement>('.notebook-toast')

    for (const toast of toasts) {
      if (toast.dataset.toastReady === 'true') continue
      const close = toast.querySelector<HTMLButtonElement>('.notebook-toast__close')
      const dismiss = () => {
        toast.dataset.leaving = 'true'
        window.setTimeout(() => toast.remove(), 150)
      }
      close?.addEventListener('click', dismiss)

      const duration = Number(toast.dataset.duration ?? 0)
      if (Number.isFinite(duration) && duration > 0) window.setTimeout(dismiss, duration)
      toast.dataset.toastReady = 'true'
    }
  }

  setupStandaloneNotebookToasts()
  document.addEventListener('astro:page-load', setupStandaloneNotebookToasts)
</script>

<style>
  .notebook-toast {
    --toast-bg: var(--notebook-post-it-blue-bg);
    --toast-ink: var(--notebook-post-it-blue-ink);
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: start;
    width: min(22rem, calc(100vw - 2rem));
    padding: 1rem 0.95rem 0.9rem;
    color: var(--toast-ink);
    background: var(--toast-bg);
    border: 1px solid color-mix(in srgb, var(--toast-ink) 34%, transparent);
    border-radius: 0.45rem 0.65rem 0.45rem 0.6rem;
    box-shadow: 0 0.8rem 1.8rem rgb(var(--notebook-shadow-rgb) / 0.18);
  }

  .notebook-toast[data-variant='success'] {
    --toast-bg: var(--notebook-post-it-mint-bg);
    --toast-ink: var(--notebook-post-it-mint-ink);
  }

  .notebook-toast[data-variant='warning'] {
    --toast-bg: var(--notebook-post-it-lemon-bg);
    --toast-ink: var(--notebook-post-it-lemon-ink);
  }

  .notebook-toast[data-variant='error'] {
    --toast-bg: var(--notebook-post-it-coral-bg);
    --toast-ink: var(--notebook-post-it-coral-ink);
  }

  .notebook-toast__tape {
    position: absolute;
    top: -0.45rem;
    left: 50%;
    width: 3.6rem;
    height: 0.75rem;
    background: color-mix(in srgb, var(--notebook-tape-paper-bg) 74%, transparent);
    transform: translateX(-50%) rotate(-0.25deg);
  }

  .notebook-toast__icon {
    display: inline-grid;
    margin-top: 0.05rem;
    transform: rotate(-2deg);
  }

  .notebook-toast__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .notebook-toast__title {
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-strong);
    line-height: 1;
  }

  .notebook-toast__content {
    font-family: var(--notebook-font-book);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .notebook-toast__content :global(> :first-child) {
    margin-top: 0;
  }

  .notebook-toast__content :global(> :last-child) {
    margin-bottom: 0;
  }

  .notebook-toast__close {
    display: inline-grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    color: var(--toast-ink);
    background: transparent;
    border: 0;
    border-radius: 50%;
  }

  .notebook-toast__close:hover {
    background: color-mix(in srgb, var(--toast-ink) 10%, transparent);
  }

  .notebook-toast__close:focus-visible {
    outline: 2px dashed var(--toast-ink);
    outline-offset: 3px;
  }
</style>
