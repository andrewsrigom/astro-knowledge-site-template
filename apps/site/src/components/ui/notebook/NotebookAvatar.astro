---
type Props = {
  badge?: 'away' | 'offline' | 'online'
  class?: string
  name: string
  role?: string
  size?: 'lg' | 'md' | 'sm'
  src?: string
}

const {
  badge,
  class: className,
  name,
  role,
  size = 'md',
  src,
}: Props = Astro.props

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('')
---

<div class:list={['notebook-avatar', className]} data-size={size}>
  <span class="notebook-avatar__portrait">
    {src ? <img alt="" src={src} /> : <span aria-hidden="true">{initials}</span>}
    {badge ? <i aria-label={badge} data-status={badge}></i> : null}
  </span>
  <span class="notebook-avatar__copy">
    <strong>{name}</strong>
    {role ? <small>{role}</small> : null}
  </span>
</div>

<style>
  .notebook-avatar {
    --avatar-size: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    color: var(--site-ink);
  }

  .notebook-avatar[data-size='sm'] { --avatar-size: 2.25rem; }
  .notebook-avatar[data-size='lg'] { --avatar-size: 4.25rem; }

  .notebook-avatar__portrait {
    position: relative;
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    overflow: visible;
    color: var(--notebook-post-it-blue-ink);
    background: var(--notebook-post-it-blue-bg);
    border: 2px solid color-mix(in srgb, var(--notebook-post-it-blue-ink) 42%, transparent);
    border-radius: 52% 48% 54% 46%;
    font-family: var(--notebook-font-hand);
    font-size: calc(var(--avatar-size) * 0.4);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-avatar__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .notebook-avatar__portrait i {
    position: absolute;
    right: -0.05rem;
    bottom: -0.05rem;
    width: calc(var(--avatar-size) * 0.27);
    height: calc(var(--avatar-size) * 0.27);
    background: var(--site-ink-muted);
    border: 2px solid var(--site-surface);
    border-radius: 50%;
  }

  .notebook-avatar__portrait i[data-status='online'] { background: var(--notebook-sticker-mint-bg); }
  .notebook-avatar__portrait i[data-status='away'] { background: var(--notebook-sticker-lemon-bg); }

  .notebook-avatar__copy {
    display: grid;
    min-width: 0;
  }

  .notebook-avatar__copy strong,
  .notebook-avatar__copy small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notebook-avatar__copy strong {
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-strong);
    line-height: 1.05;
  }

  .notebook-avatar__copy small {
    color: var(--site-ink-muted);
    font-size: 0.78rem;
  }
</style>
