---
type PyramidLayer = {
  description?: string
  label: string
  tone: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  caption?: string
  class?: string
  layers: PyramidLayer[]
}

const {
  caption,
  class: className,
  layers,
} = Astro.props

const totalLayers = layers.length
const minWidth = 42
const maxWidth = 100
const stepWidth = totalLayers > 1 ? (maxWidth - minWidth) / (totalLayers - 1) : 0
---

<figure class:list={['notebook-pyramid', className]}>
  <div class="notebook-pyramid__stack">
    {layers.map((layer, index) => {
      const width = minWidth + stepWidth * index
      return (
        <div
          class="notebook-pyramid__layer"
          data-tone={layer.tone}
          style={`width: ${width}%;`}
        >
          <span class="notebook-pyramid__label">{layer.label}</span>
          {layer.description ? (
            <span class="notebook-pyramid__description">{layer.description}</span>
          ) : null}
        </div>
      )
    })}
  </div>
  {caption ? <figcaption class="notebook-pyramid__caption">{caption}</figcaption> : null}
</figure>

<style>
  .notebook-pyramid {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 1.5rem 1.25rem 1.35rem;
    background: color-mix(in srgb, var(--site-surface) 92%, transparent);
    border: 1px solid var(--site-line);
    border-radius: 0.9rem;
  }

  .notebook-pyramid__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .notebook-pyramid__layer {
    --layer-bg: var(--notebook-post-it-blue-bg);
    --layer-ink: var(--notebook-post-it-blue-ink);
    display: grid;
    gap: 0.15rem;
    box-sizing: border-box;
    min-width: 8rem;
    padding: 0.65rem 1.1rem 0.7rem;
    color: var(--layer-ink);
    background: var(--layer-bg);
    /* trapezoide sutil — mais estreito no topo */
    clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
    text-align: center;
    box-shadow: inset 0 -0.18rem 0.3rem color-mix(in srgb, var(--layer-ink) 14%, transparent);
  }

  .notebook-pyramid__layer[data-tone='coral'] {
    --layer-bg: var(--notebook-post-it-coral-bg);
    --layer-ink: var(--notebook-post-it-coral-ink);
  }

  .notebook-pyramid__layer[data-tone='mint'] {
    --layer-bg: var(--notebook-post-it-mint-bg);
    --layer-ink: var(--notebook-post-it-mint-ink);
  }

  .notebook-pyramid__layer[data-tone='lemon'] {
    --layer-bg: var(--notebook-post-it-lemon-bg);
    --layer-ink: var(--notebook-post-it-lemon-ink);
  }

  .notebook-pyramid__layer[data-tone='pink'] {
    --layer-bg: var(--notebook-post-it-pink-bg);
    --layer-ink: var(--notebook-post-it-pink-ink);
  }

  .notebook-pyramid__layer[data-tone='violet'] {
    --layer-bg: var(--notebook-sticker-violet-bg);
    --layer-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-pyramid__label {
    font-family: var(--notebook-font-hand);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .notebook-pyramid__description {
    font-family: var(--notebook-font-hand);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0.78;
  }

  .notebook-pyramid__caption {
    margin: 0;
    color: var(--site-ink-muted);
    font-size: 0.85rem;
    line-height: 1.45;
    text-align: center;
  }
</style>
