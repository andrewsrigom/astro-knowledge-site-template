---
import CadBreadcrumb from '@caderno-ui/astro/Breadcrumb.astro'

type BreadcrumbItem = {
  href?: string
  label: string
}

type Props = {
  ariaLabel?: string
  class?: string
  items: BreadcrumbItem[]
}

const {
  ariaLabel = 'Navegação estrutural',
  class: className,
  items,
}: Props = Astro.props
---

<CadBreadcrumb
  class:list={['notebook-breadcrumb', className]}
  items={items}
  label={ariaLabel}
/>
