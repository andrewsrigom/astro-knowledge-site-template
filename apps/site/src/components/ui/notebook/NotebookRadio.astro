---
type Props = {
  checked?: boolean
  class?: string
  disabled?: boolean
  hint?: string
  id: string
  label: string
  name: string
  required?: boolean
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
  value: string
}

const {
  checked = false,
  class: className,
  disabled = false,
  hint,
  id,
  label,
  name,
  required = false,
  tone = 'accent',
  value,
} = Astro.props
---

<label class:list={['notebook-radio', className]} data-tone={tone} data-disabled={disabled ? 'true' : 'false'} for={id}>
  <input
    checked={checked}
    class="notebook-radio__input"
    disabled={disabled}
    id={id}
    name={name}
    required={required}
    type="radio"
    value={value}
  />
  <span aria-hidden="true" class="notebook-radio__ring">
    <span class="notebook-radio__dot"></span>
  </span>
  <span class="notebook-radio__body">
    <span class="notebook-radio__label">{label}</span>
    {hint ? <span class="notebook-radio__hint">{hint}</span> : null}
  </span>
</label>

<style>
  .notebook-radio {
    --radio-ink: var(--notebook-post-it-blue-ink);
    --radio-bg: var(--notebook-post-it-blue-bg);
    display: inline-grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;
    color: var(--site-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .notebook-radio[data-tone='coral'] {
    --radio-ink: var(--notebook-post-it-coral-ink);
    --radio-bg: var(--notebook-post-it-coral-bg);
  }
  .notebook-radio[data-tone='mint'] {
    --radio-ink: var(--notebook-post-it-mint-ink);
    --radio-bg: var(--notebook-post-it-mint-bg);
  }
  .notebook-radio[data-tone='lemon'] {
    --radio-ink: var(--notebook-post-it-lemon-ink);
    --radio-bg: var(--notebook-post-it-lemon-bg);
  }
  .notebook-radio[data-tone='pink'] {
    --radio-ink: var(--notebook-post-it-pink-ink);
    --radio-bg: var(--notebook-post-it-pink-bg);
  }
  .notebook-radio[data-tone='violet'] {
    --radio-ink: var(--notebook-sticker-violet-ink);
    --radio-bg: var(--notebook-sticker-violet-bg);
  }

  .notebook-radio[data-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .notebook-radio__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .notebook-radio__ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.15rem;
    background: transparent;
    border: 2px solid color-mix(in srgb, var(--radio-ink) 55%, transparent);
    /* círculo torto à mão */
    border-radius: 54% 46% 52% 48%;
    transition: border-color 140ms var(--site-transition-smooth), transform 140ms var(--site-transition-smooth);
    transform: rotate(-3deg);
  }

  .notebook-radio__dot {
    display: block;
    width: 0.85rem;
    height: 0.85rem;
    background: var(--radio-ink);
    border-radius: 52% 48% 54% 46%;
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 120ms var(--site-transition-smooth), transform 160ms var(--site-transition-smooth);
  }

  .notebook-radio__input:checked ~ .notebook-radio__ring {
    border-color: var(--radio-ink);
    background: color-mix(in srgb, var(--radio-bg) 40%, transparent);
  }

  .notebook-radio__input:checked ~ .notebook-radio__ring .notebook-radio__dot {
    opacity: 1;
    transform: scale(1);
  }

  .notebook-radio__input:focus-visible ~ .notebook-radio__ring {
    outline: 2px dashed var(--radio-ink);
    outline-offset: 3px;
  }

  .notebook-radio:hover:not([data-disabled='true']) .notebook-radio__ring {
    transform: rotate(-3deg) translateY(-1px);
  }

  .notebook-radio__body {
    display: inline-grid;
    gap: 0.15rem;
    padding-top: 0.15rem;
  }

  .notebook-radio__label {
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.25;
  }

  .notebook-radio__hint {
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    line-height: 1.3;
  }
</style>
