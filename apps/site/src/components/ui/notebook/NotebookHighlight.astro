---
import '@/styles/notebook-highlight.css'

type Props = {
  class?: string
  tone?: 'blue' | 'green' | 'orange' | 'pink' | 'violet' | 'yellow'
  variant?: 'double' | 'marker' | 'underline'
}

const {
  class: className,
  tone = 'yellow',
  variant = 'marker',
} = Astro.props
---

<mark class:list={['notebook-highlight', className]} data-tone={tone} data-variant={variant}><slot /></mark>
