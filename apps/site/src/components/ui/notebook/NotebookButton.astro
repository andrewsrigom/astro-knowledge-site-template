---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  ariaLabel?: string
  as?: 'a' | 'button'
  class?: string
  disabled?: boolean
  href?: string
  icon?: NotebookDoodleName
  iconPosition?: 'end' | 'start'
  size?: 'lg' | 'md' | 'sm'
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
  type?: 'button' | 'reset' | 'submit'
  variant?: 'ghost' | 'link' | 'primary' | 'secondary'
}

const {
  ariaLabel,
  as,
  class: className,
  disabled = false,
  href,
  icon,
  iconPosition = 'start',
  size = 'md',
  tone = 'accent',
  type = 'button',
  variant = 'primary',
}: Props = Astro.props

const tag = as ?? (href ? 'a' : 'button')
const iconSize = size === 'sm' ? 16 : size === 'lg' ? 22 : 18
---

<Fragment>
  {tag === 'a' ? (
    <a
      aria-disabled={disabled || undefined}
      aria-label={ariaLabel}
      class:list={['notebook-button', className]}
      data-size={size}
      data-tone={tone}
      data-variant={variant}
      href={disabled ? undefined : href}
      tabindex={disabled ? -1 : undefined}
    >
      {icon && iconPosition === 'start' ? (
        <span class="notebook-button__icon" data-position="start">
          <DoodleIcon name={icon} size={iconSize} />
        </span>
      ) : null}
      <span class="notebook-button__label"><slot /></span>
      {icon && iconPosition === 'end' ? (
        <span class="notebook-button__icon" data-position="end">
          <DoodleIcon name={icon} size={iconSize} />
        </span>
      ) : null}
    </a>
  ) : (
    <button
      aria-label={ariaLabel}
      class:list={['notebook-button', className]}
      data-size={size}
      data-tone={tone}
      data-variant={variant}
      disabled={disabled}
      type={type}
    >
      {icon && iconPosition === 'start' ? (
        <span class="notebook-button__icon" data-position="start">
          <DoodleIcon name={icon} size={iconSize} />
        </span>
      ) : null}
      <span class="notebook-button__label"><slot /></span>
      {icon && iconPosition === 'end' ? (
        <span class="notebook-button__icon" data-position="end">
          <DoodleIcon name={icon} size={iconSize} />
        </span>
      ) : null}
    </button>
  )}
</Fragment>

<style>
  .notebook-button {
    --btn-bg: var(--notebook-post-it-blue-bg);
    --btn-ink: var(--notebook-post-it-blue-ink);
    --btn-underline: color-mix(in srgb, var(--btn-ink) 62%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem 0.6rem;
    color: var(--btn-ink);
    background: var(--btn-bg);
    border: 1.5px solid color-mix(in srgb, var(--btn-ink) 42%, transparent);
    border-radius: 0.7rem 0.95rem 0.7rem 0.9rem;
    box-shadow:
      0 0.35rem 0.75rem rgb(var(--notebook-shadow-rgb) / 0.14),
      inset 0 -0.18rem 0.3rem color-mix(in srgb, var(--btn-ink) 18%, transparent),
      inset 0 0.12rem 0 color-mix(in srgb, white 30%, transparent);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-strong);
    line-height: 1.05;
    text-decoration: none;
    cursor: pointer;
    transition: transform 140ms var(--site-transition-smooth), box-shadow 140ms var(--site-transition-smooth), background 140ms var(--site-transition-smooth);
    transform: rotate(-0.3deg);
    -webkit-tap-highlight-color: transparent;
  }

  /* TONES */
  .notebook-button[data-tone='accent'] {
    --btn-bg: var(--notebook-post-it-blue-bg);
    --btn-ink: var(--notebook-post-it-blue-ink);
  }
  .notebook-button[data-tone='coral'] {
    --btn-bg: var(--notebook-post-it-coral-bg);
    --btn-ink: var(--notebook-post-it-coral-ink);
  }
  .notebook-button[data-tone='mint'] {
    --btn-bg: var(--notebook-post-it-mint-bg);
    --btn-ink: var(--notebook-post-it-mint-ink);
  }
  .notebook-button[data-tone='lemon'] {
    --btn-bg: var(--notebook-post-it-lemon-bg);
    --btn-ink: var(--notebook-post-it-lemon-ink);
  }
  .notebook-button[data-tone='pink'] {
    --btn-bg: var(--notebook-post-it-pink-bg);
    --btn-ink: var(--notebook-post-it-pink-ink);
  }
  .notebook-button[data-tone='violet'] {
    --btn-bg: var(--notebook-sticker-violet-bg);
    --btn-ink: var(--notebook-sticker-violet-ink);
  }

  /* SIZES */
  .notebook-button[data-size='sm'] {
    padding: 0.35rem 0.75rem 0.4rem;
    font-size: var(--notebook-hand-sm);
    gap: 0.35rem;
  }
  .notebook-button[data-size='lg'] {
    padding: 0.75rem 1.35rem 0.8rem;
    font-size: var(--notebook-hand-lg);
    gap: 0.55rem;
    border-radius: 0.85rem 1.1rem 0.85rem 1.05rem;
  }

  /* VARIANTS */
  /* PRIMARY — usa a paleta sólida (default) */

  /* SECONDARY — contorno mantendo o rabisco */
  .notebook-button[data-variant='secondary'] {
    color: var(--btn-ink);
    background: transparent;
    border: 1.5px dashed color-mix(in srgb, var(--btn-ink) 65%, transparent);
    box-shadow: none;
  }

  /* GHOST — sem contorno, texto colorido, quase invisível até hover */
  .notebook-button[data-variant='ghost'] {
    color: color-mix(in srgb, var(--btn-ink) 82%, var(--site-ink));
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    transform: rotate(0deg);
  }

  /* LINK — só o marca-texto embaixo, tipo palavra sublinhada à mão */
  .notebook-button[data-variant='link'] {
    padding: 0.1rem 0.25rem;
    color: var(--site-ink);
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    transform: rotate(0deg);
    background-image: linear-gradient(
      180deg,
      transparent 68%,
      color-mix(in srgb, var(--btn-bg) 72%, transparent) 69%,
      color-mix(in srgb, var(--btn-bg) 72%, transparent) 93%,
      transparent 94%
    );
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  /* Interactions */
  .notebook-button:not([disabled]):hover,
  .notebook-button:not([aria-disabled='true']):hover {
    transform: rotate(-0.4deg) translateY(-1px);
    box-shadow:
      0 0.55rem 1.1rem rgb(var(--notebook-shadow-rgb) / 0.18),
      inset 0 -0.18rem 0.3rem color-mix(in srgb, var(--btn-ink) 22%, transparent),
      inset 0 0.12rem 0 color-mix(in srgb, white 34%, transparent);
  }

  .notebook-button[data-variant='ghost']:not([disabled]):hover,
  .notebook-button[data-variant='ghost']:not([aria-disabled='true']):hover,
  .notebook-button[data-variant='secondary']:not([disabled]):hover,
  .notebook-button[data-variant='secondary']:not([aria-disabled='true']):hover {
    background: color-mix(in srgb, var(--btn-bg) 30%, transparent);
    box-shadow: none;
  }

  .notebook-button[data-variant='link']:not([disabled]):hover,
  .notebook-button[data-variant='link']:not([aria-disabled='true']):hover {
    background-image: linear-gradient(
      180deg,
      transparent 60%,
      color-mix(in srgb, var(--btn-bg) 88%, transparent) 61%,
      color-mix(in srgb, var(--btn-bg) 88%, transparent) 93%,
      transparent 94%
    );
    transform: none;
    box-shadow: none;
  }

  .notebook-button:active {
    transform: rotate(-0.3deg) translateY(1px);
    box-shadow:
      0 0.15rem 0.35rem rgb(var(--notebook-shadow-rgb) / 0.16),
      inset 0 -0.06rem 0.14rem color-mix(in srgb, var(--btn-ink) 22%, transparent);
  }

  .notebook-button:focus-visible {
    outline: 2px dashed color-mix(in srgb, var(--btn-ink) 78%, var(--site-ink));
    outline-offset: 3px;
  }

  .notebook-button[disabled],
  .notebook-button[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
    box-shadow: none;
  }

  .notebook-button__icon {
    display: inline-grid;
    place-items: center;
    color: currentColor;
  }

  .notebook-button__icon[data-position='start'] {
    transform: rotate(-4deg);
  }

  .notebook-button__icon[data-position='end'] {
    transform: rotate(4deg);
  }

  .notebook-button__label {
    display: inline-block;
    letter-spacing: 0.01em;
  }
</style>
