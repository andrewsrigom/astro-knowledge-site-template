---
import CadAlert from '@caderno-ui/astro/Alert.astro'
import type { CadAlertVariant } from '@caderno-ui/elements/alert'

type Props = {
  class?: string
  dismissLabel?: string
  dismissible?: boolean
  title: string
  variant?: CadAlertVariant
}

const {
  class: className,
  dismissLabel = 'Dispensar aviso',
  dismissible = false,
  title,
  variant = 'info',
} = Astro.props
---

<CadAlert
  class={className}
  dismissLabel={dismissLabel}
  dismissible={dismissible}
  title={title}
  variant={variant}
>
  <slot />
</CadAlert>
