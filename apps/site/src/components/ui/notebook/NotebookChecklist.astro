---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'

type ChecklistItem = {
  kind?: 'check' | 'cross'
  label: string
}

type Props = {
  class?: string
  items: ChecklistItem[]
  title?: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
  variant?: 'do' | 'dont' | 'mixed'
}

const {
  class: className,
  items,
  title,
  tone = 'mint',
  variant = 'mixed',
} = Astro.props

const resolveKind = (item: ChecklistItem): 'check' | 'cross' => {
  if (item.kind) return item.kind
  if (variant === 'do') return 'check'
  if (variant === 'dont') return 'cross'
  return 'check'
}
---

<section class:list={['notebook-checklist', className]} data-tone={tone} data-variant={variant}>
  {title ? <h3 class="notebook-checklist__title">{title}</h3> : null}
  <ul class="notebook-checklist__list">
    {items.map((item) => {
      const kind = resolveKind(item)
      return (
        <li class="notebook-checklist__item" data-kind={kind}>
          <span aria-hidden="true" class="notebook-checklist__mark">
            <DoodleIcon name={kind} size={22} />
          </span>
          <span class="notebook-checklist__label">{item.label}</span>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .notebook-checklist {
    --check-accent: var(--notebook-post-it-mint-ink);
    --check-surface: color-mix(in srgb, var(--notebook-post-it-mint-bg) 32%, transparent);
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem 1.25rem 1.2rem;
    background: var(--check-surface);
    border: 1.5px dashed color-mix(in srgb, var(--check-accent) 35%, transparent);
    border-radius: 0.9rem 1.2rem 0.85rem 1.05rem;
  }

  .notebook-checklist[data-tone='pink'] {
    --check-accent: var(--notebook-post-it-pink-ink);
    --check-surface: color-mix(in srgb, var(--notebook-post-it-pink-bg) 32%, transparent);
  }

  .notebook-checklist[data-tone='blue'] {
    --check-accent: var(--notebook-post-it-blue-ink);
    --check-surface: color-mix(in srgb, var(--notebook-post-it-blue-bg) 32%, transparent);
  }

  .notebook-checklist[data-tone='coral'] {
    --check-accent: var(--notebook-post-it-coral-ink);
    --check-surface: color-mix(in srgb, var(--notebook-post-it-coral-bg) 32%, transparent);
  }

  .notebook-checklist[data-tone='lemon'] {
    --check-accent: var(--notebook-post-it-lemon-ink);
    --check-surface: color-mix(in srgb, var(--notebook-post-it-lemon-bg) 32%, transparent);
  }

  .notebook-checklist[data-tone='violet'] {
    --check-accent: var(--notebook-sticker-violet-ink);
    --check-surface: color-mix(in srgb, var(--notebook-sticker-violet-bg) 30%, transparent);
  }

  .notebook-checklist__title {
    margin: 0;
    color: var(--check-accent);
    font-family: var(--notebook-font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notebook-checklist__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notebook-checklist__item {
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    align-items: start;
    gap: 0.55rem;
    color: var(--site-ink);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .notebook-checklist__mark {
    display: inline-grid;
    place-items: center;
    width: 1.8rem;
    height: 1.6rem;
    color: var(--check-accent);
  }

  .notebook-checklist__item[data-kind='cross'] .notebook-checklist__mark {
    color: color-mix(in srgb, var(--notebook-sticker-coral-ink) 68%, var(--site-ink));
    transform: rotate(-3deg);
  }

  .notebook-checklist__item[data-kind='check'] .notebook-checklist__mark {
    transform: rotate(-2deg);
  }

  .notebook-checklist__label {
    padding-top: 0.05rem;
  }

  .notebook-checklist__item[data-kind='cross'] .notebook-checklist__label {
    color: var(--site-ink-soft);
  }
</style>
