---
type KanbanCard = {
  label: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink'
}

type KanbanColumn = {
  cards: KanbanCard[]
  id: string
  title: string
}

type Props = {
  class?: string
  columns: KanbanColumn[]
}

const {
  class: className,
  columns,
}: Props = Astro.props
---

<div class:list={['notebook-kanban', className]} style={`--kanban-columns: ${Math.max(1, columns.length)}`}>
  {columns.map((column) => (
    <section class="notebook-kanban__column" data-column-id={column.id}>
      <header>
        <h3>{column.title}</h3>
        <span>{column.cards.length}</span>
      </header>
      <ol>
        {column.cards.map((card) => (
          <li data-tone={card.tone ?? 'lemon'}>{card.label}</li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .notebook-kanban {
    display: grid;
    grid-template-columns: repeat(var(--kanban-columns, 3), minmax(13rem, 1fr));
    gap: 1rem;
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 0.35rem;
  }

  .notebook-kanban__column {
    min-width: 13rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--site-surface) 88%, var(--site-surface-strong));
    border: 1px dashed var(--site-line-strong);
    border-radius: 0.75rem 0.95rem 0.7rem 0.9rem;
  }

  .notebook-kanban__column header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0 0.2rem 0.65rem;
  }

  .notebook-kanban__column h3,
  .notebook-kanban__column header span {
    margin: 0;
    font-family: var(--notebook-font-hand);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-kanban__column h3 {
    font-size: var(--notebook-hand-lg);
    line-height: 1;
  }

  .notebook-kanban__column header span {
    display: inline-grid;
    place-items: center;
    min-width: 1.7rem;
    height: 1.7rem;
    color: var(--notebook-post-it-blue-ink);
    background: var(--notebook-post-it-blue-bg);
    border-radius: 50%;
  }

  .notebook-kanban__column ol {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .notebook-kanban__column li {
    --kanban-card-bg: var(--notebook-post-it-lemon-bg);
    --kanban-card-ink: var(--notebook-post-it-lemon-ink);
    padding: 0.75rem 0.8rem 0.8rem;
    color: var(--kanban-card-ink);
    background: var(--kanban-card-bg);
    box-shadow: 0 0.35rem 0.65rem rgb(var(--notebook-shadow-rgb) / 0.1);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1.2;
    transform: rotate(-0.25deg);
  }

  .notebook-kanban__column li[data-tone='blue'] {
    --kanban-card-bg: var(--notebook-post-it-blue-bg);
    --kanban-card-ink: var(--notebook-post-it-blue-ink);
  }
  .notebook-kanban__column li[data-tone='coral'] {
    --kanban-card-bg: var(--notebook-post-it-coral-bg);
    --kanban-card-ink: var(--notebook-post-it-coral-ink);
  }
  .notebook-kanban__column li[data-tone='mint'] {
    --kanban-card-bg: var(--notebook-post-it-mint-bg);
    --kanban-card-ink: var(--notebook-post-it-mint-ink);
  }
  .notebook-kanban__column li[data-tone='pink'] {
    --kanban-card-bg: var(--notebook-post-it-pink-bg);
    --kanban-card-ink: var(--notebook-post-it-pink-ink);
  }
</style>
