---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'
import '@/styles/notebook-post-it.css'

type Props = {
  class?: string
  icon?: NotebookDoodleName
  label?: string
  tilt?: 'left' | 'none' | 'right'
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink'
}

const {
  class: className,
  icon,
  label,
  tilt = 'left',
  tone = 'lemon',
} = Astro.props
---

<aside class:list={['notebook-post-it', className]} data-tilt={tilt} data-tone={tone}>
  <span aria-hidden="true" class="notebook-post-it__tape"></span>
  {label ? (
    <p class="notebook-post-it__label">
      {icon ? <DoodleIcon name={icon} size={17} /> : null}
      <span>{label}</span>
    </p>
  ) : null}
  <div class="notebook-post-it__content"><slot /></div>
</aside>
