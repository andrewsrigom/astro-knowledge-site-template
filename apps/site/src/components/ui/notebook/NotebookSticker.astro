---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  class?: string
  icon?: NotebookDoodleName
  label: string
  shape?: 'banner' | 'bubble' | 'burst' | 'label' | 'round'
  size?: 'medium' | 'small'
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'violet'
}

const {
  class: className,
  icon,
  label,
  shape = 'label',
  size = 'medium',
  tone = 'blue',
} = Astro.props
---

<span class:list={['notebook-sticker', className]} data-shape={shape} data-size={size} data-tone={tone}>
  <span class="notebook-sticker__surface">
    {icon ? <DoodleIcon name={icon} size={size === 'small' ? 14 : 18} /> : null}
    <span class="notebook-sticker__text">{label}</span>
  </span>
</span>

<style>
  .notebook-sticker {
    --sticker-bg: var(--notebook-sticker-blue-bg);
    --sticker-ink: var(--notebook-sticker-blue-ink);
    position: relative;
    display: inline-flex;
    color: var(--sticker-ink);
    background: transparent;
    filter: drop-shadow(0 0.22rem 0.24rem rgb(var(--notebook-shadow-rgb) / 0.16));
    transform: rotate(-0.4deg);
  }

  .notebook-sticker[data-tone='coral'] {
    --sticker-bg: var(--notebook-sticker-coral-bg);
    --sticker-ink: var(--notebook-sticker-coral-ink);
    transform: rotate(0.4deg);
  }

  .notebook-sticker[data-tone='lemon'] {
    --sticker-bg: var(--notebook-sticker-lemon-bg);
    --sticker-ink: var(--notebook-sticker-lemon-ink);
    transform: rotate(-0.25deg);
  }

  .notebook-sticker[data-tone='mint'] {
    --sticker-bg: var(--notebook-sticker-mint-bg);
    --sticker-ink: var(--notebook-sticker-mint-ink);
    transform: rotate(0.3deg);
  }

  .notebook-sticker[data-tone='violet'] {
    --sticker-bg: var(--notebook-sticker-violet-bg);
    --sticker-ink: var(--notebook-sticker-violet-ink);
    transform: rotate(-0.5deg);
  }

  .notebook-sticker,
  .notebook-sticker__surface {
    border-radius: 0.85rem 1.05rem 0.8rem 0.95rem;
  }

  .notebook-sticker__surface {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    min-height: 2.1rem;
    padding: 0.42rem 0.72rem 0.45rem;
    background: var(--sticker-bg);
    font-family: var(--notebook-font-hand);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
    box-shadow:
      inset 0 -0.16rem 0.28rem color-mix(in srgb, var(--sticker-ink) 22%, transparent),
      inset 0 0.12rem 0 color-mix(in srgb, white 32%, transparent);
  }

  .notebook-sticker__text {
    display: inline-block;
  }

  .notebook-sticker[data-size='small'] {
    /* size hook reserved for shape overrides */
  }

  .notebook-sticker[data-size='small'] .notebook-sticker__surface {
    min-height: 1.65rem;
    padding: 0.27rem 0.52rem 0.3rem;
    font-size: 0.67rem;
  }

  /* ROUND — círculo com pinch orgânico, tipo botton */
  .notebook-sticker[data-shape='round'],
  .notebook-sticker[data-shape='round'] .notebook-sticker__surface {
    border-radius: 52% 48% 50% 46%;
  }

  .notebook-sticker[data-shape='round'] .notebook-sticker__surface {
    min-width: 4.6rem;
    min-height: 4.25rem;
    padding: 0.75rem;
    flex-direction: column;
  }

  /* BURST — starburst 12 pontas mais limpo */
  .notebook-sticker[data-shape='burst'],
  .notebook-sticker[data-shape='burst'] .notebook-sticker__surface {
    clip-path: polygon(
      50% 0%, 58% 12%, 71% 4%, 74% 18%, 88% 15%, 85% 29%, 98% 30%, 89% 43%, 100% 54%,
      87% 58%, 92% 73%, 78% 71%, 79% 86%, 65% 79%, 60% 94%, 50% 84%, 40% 94%, 35% 79%,
      21% 86%, 22% 71%, 8% 73%, 13% 58%, 0% 54%, 11% 43%, 2% 30%, 15% 29%, 12% 15%,
      26% 18%, 29% 4%, 42% 12%
    );
  }

  .notebook-sticker[data-shape='burst'] .notebook-sticker__surface {
    min-width: 5.6rem;
    min-height: 5.1rem;
    padding: 1.05rem 0.85rem;
    border-radius: 0;
    flex-direction: column;
    text-align: center;
  }

  /* BANNER — flâmula/pennant com notch triangular à direita */
  .notebook-sticker[data-shape='banner'],
  .notebook-sticker[data-shape='banner'] .notebook-sticker__surface {
    border-radius: 0.45rem 0 0 0.45rem;
    clip-path: polygon(0 0, 82% 0, 100% 50%, 82% 100%, 0 100%);
  }

  .notebook-sticker[data-shape='banner'] .notebook-sticker__surface {
    padding-right: 1.35rem;
  }

  .notebook-sticker[data-size='small'][data-shape='banner'] .notebook-sticker__surface {
    padding-right: 1.05rem;
  }

  /* BUBBLE — balão de fala com rabinho embaixo à esquerda */
  .notebook-sticker[data-shape='bubble'],
  .notebook-sticker[data-shape='bubble'] .notebook-sticker__surface {
    border-radius: 1rem 1.1rem 1rem 1rem;
  }

  .notebook-sticker[data-shape='bubble'] {
    padding-bottom: 0.55rem;
  }

  .notebook-sticker[data-shape='bubble']::after {
    content: '';
    position: absolute;
    left: 1.15rem;
    bottom: -0.05rem;
    width: 0.95rem;
    height: 0.65rem;
    background: var(--sticker-bg);
    clip-path: polygon(0 0, 100% 0, 25% 100%);
    filter: drop-shadow(0 0.14rem 0.16rem rgb(var(--notebook-shadow-rgb) / 0.14));
  }

  .notebook-sticker[data-size='small'][data-shape='bubble']::after {
    left: 0.85rem;
    width: 0.75rem;
    height: 0.5rem;
  }
</style>
