---
import CadSticker from '@caderno-ui/astro/Sticker.astro'
import CadIcon from '@caderno-ui/astro/Icon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  class?: string
  icon?: NotebookDoodleName
  label: string
  shape?: 'banner' | 'bubble' | 'burst' | 'label' | 'round'
  size?: 'medium' | 'small'
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'violet'
}

const {
  class: className,
  icon,
  label,
  shape = 'label',
  size = 'medium',
  tone = 'blue',
}: Props = Astro.props
---

<CadSticker
  class:list={['notebook-sticker', className]}
  label={label}
  shape={shape}
  size={size === 'small' ? 'sm' : 'md'}
  tone={tone}
>
  {icon ? (
    <Fragment slot="start"><CadIcon name={icon} size={16} /></Fragment>
  ) : null}
  {label}
</CadSticker>
