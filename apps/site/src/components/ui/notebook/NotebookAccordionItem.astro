---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import '@/styles/notebook-accordion.css'

type Props = {
  class?: string
  open?: boolean
  title: string
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

const {
  class: className,
  open = false,
  title,
  tone = 'accent',
}: Props = Astro.props
---

<details
  class:list={['notebook-accordion-item', className]}
  data-notebook-accordion-item
  data-tone={tone}
  open={open}
>
  <summary>
    <span aria-hidden="true" class="notebook-accordion-item__tape"></span>
    <span>{title}</span>
    <span aria-hidden="true" class="notebook-accordion-item__indicator">
      <DoodleIcon name="arrow-right" size={17} />
    </span>
  </summary>
  <div class="notebook-accordion-item__content"><slot /></div>
</details>
