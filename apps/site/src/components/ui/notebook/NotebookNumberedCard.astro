---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Props = {
  class?: string
  icon?: NotebookDoodleName
  number: number | string
  title: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

const {
  class: className,
  icon,
  number,
  title,
  tone = 'blue',
} = Astro.props
---

<article class:list={['notebook-numbered-card', className]} data-tone={tone}>
  <span aria-hidden="true" class="notebook-numbered-card__number">
    {number}
  </span>
  <div class="notebook-numbered-card__body">
    <h3 class="notebook-numbered-card__title">
      {icon ? <DoodleIcon name={icon} size={18} /> : null}
      <span>{title}</span>
    </h3>
    <div class="notebook-numbered-card__content"><slot /></div>
  </div>
</article>

<style>
  .notebook-numbered-card {
    --card-accent-bg: var(--notebook-sticker-blue-bg);
    --card-accent-ink: var(--notebook-sticker-blue-ink);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    padding: 1.15rem 1.2rem 1.2rem;
    color: var(--site-ink);
    background: var(--notebook-paper-white);
    border: 1.5px solid color-mix(in srgb, var(--card-accent-ink) 22%, transparent);
    border-radius: 0.85rem 1.15rem 0.9rem 1.05rem;
    box-shadow: 0 0.55rem 1.1rem rgb(var(--notebook-shadow-rgb) / 0.09);
  }

  .notebook-numbered-card[data-tone='coral'] {
    --card-accent-bg: var(--notebook-sticker-coral-bg);
    --card-accent-ink: var(--notebook-sticker-coral-ink);
  }

  .notebook-numbered-card[data-tone='lemon'] {
    --card-accent-bg: var(--notebook-sticker-lemon-bg);
    --card-accent-ink: var(--notebook-sticker-lemon-ink);
  }

  .notebook-numbered-card[data-tone='mint'] {
    --card-accent-bg: var(--notebook-sticker-mint-bg);
    --card-accent-ink: var(--notebook-sticker-mint-ink);
  }

  .notebook-numbered-card[data-tone='violet'] {
    --card-accent-bg: var(--notebook-sticker-violet-bg);
    --card-accent-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-numbered-card[data-tone='pink'] {
    --card-accent-bg: var(--notebook-post-it-pink-bg);
    --card-accent-ink: var(--notebook-post-it-pink-ink);
  }

  .notebook-numbered-card__number {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--card-accent-ink);
    background: var(--card-accent-bg);
    border-radius: 52% 48% 55% 45%;
    font-family: var(--notebook-font-hand);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    transform: rotate(-2.5deg);
    box-shadow: inset 0 -0.18rem 0.4rem rgb(var(--notebook-shadow-rgb) / 0.14);
  }

  .notebook-numbered-card__body {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .notebook-numbered-card__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--card-accent-ink);
    font-family: var(--notebook-font-hand);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .notebook-numbered-card__content {
    color: var(--site-ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .notebook-numbered-card__content :global(> :first-child) {
    margin-top: 0;
  }

  .notebook-numbered-card__content :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
