---
import NotebookBookmark from '@/components/ui/notebook/NotebookBookmark.astro'
import NotebookBreadcrumb from '@/components/ui/notebook/NotebookBreadcrumb.astro'
import NotebookPagination from '@/components/ui/notebook/NotebookPagination.astro'
import NotebookProgress from '@/components/ui/notebook/NotebookProgress.astro'
import NotebookTOC from '@/components/ui/notebook/NotebookTOC.astro'
---

<div class="notebook-navigation-showcase">
  <section class="notebook-navigation-section" aria-labelledby="navigation-path-title">
    <header>
      <p>Navegação do livro</p>
      <h2 id="navigation-path-title">Localização e retorno</h2>
      <span>A página deixa claro onde o leitor está e permite marcar um ponto para voltar depois.</span>
    </header>
    <div class="notebook-navigation-frame">
      <NotebookBreadcrumb
        items={[
          { label: 'Guia', href: '/pt-br/guia' },
          { label: 'JavaScript e TypeScript', href: '/pt-br/guia/volumes/javascript-typescript' },
          { label: 'Resolução de problemas' },
        ]}
      />
      <NotebookBookmark
        activeLabel="Seção marcada"
        id="navigation-showcase"
        label="Salvar para depois"
        persist
      />
    </div>
  </section>

  <section class="notebook-navigation-section" aria-labelledby="navigation-progress-title">
    <header>
      <p>Progresso</p>
      <h2 id="navigation-progress-title">Avanço sem transformar o livro em curso</h2>
      <span>O indicador informa posição e conclusão, sem impor tempo ou cronograma.</span>
    </header>
    <div class="notebook-navigation-progress-grid">
      <div class="notebook-navigation-demo">
        <h3>Barra</h3>
        <NotebookProgress label="Página 3 de 10" value={0.3} />
      </div>
      <div class="notebook-navigation-demo">
        <h3>Etapas</h3>
        <NotebookProgress current={2} label="Etapa 2 de 5" steps={5} variant="steps" />
      </div>
      <div class="notebook-navigation-demo notebook-navigation-demo--ring">
        <h3>Anel</h3>
        <NotebookProgress label="Leitura concluída em 64%" value={0.64} variant="ring" />
      </div>
    </div>
  </section>

  <section class="notebook-navigation-section" aria-labelledby="navigation-toc-title">
    <header>
      <p>Índice local</p>
      <h2 id="navigation-toc-title">Dentro do capítulo</h2>
      <span>O índice acompanha a progressão do texto e marca a seção visível.</span>
    </header>
    <div class="notebook-navigation-toc-layout">
      <NotebookTOC
        items={[
          { id: 'toc-demo-contract', title: 'Definindo o contrato', level: 2 },
          { id: 'toc-demo-edges', title: 'Casos de borda', level: 3 },
          { id: 'toc-demo-solution', title: 'Construindo a solução', level: 2 },
        ]}
        selector="#notebook-toc-demo h3, #notebook-toc-demo h4"
      />
      <article class="notebook-navigation-article" id="notebook-toc-demo">
        <h3 id="toc-demo-contract">Definindo o contrato</h3>
        <p>Antes do código, declare entradas, saídas, limites e a política para dados inválidos.</p>
        <h4 id="toc-demo-edges">Casos de borda</h4>
        <p>Entrada vazia, repetição, limites numéricos e ordenação precisam de uma decisão explícita.</p>
        <h3 id="toc-demo-solution">Construindo a solução</h3>
        <p>A estrutura de dados é escolhida pelas operações que o contrato exige.</p>
      </article>
    </div>
  </section>

  <section class="notebook-navigation-section" aria-labelledby="navigation-pagination-title">
    <header>
      <p>Coleções</p>
      <h2 id="navigation-pagination-title">Paginação</h2>
      <span>Números manuscritos, página atual circulada e truncamento para coleções longas.</span>
    </header>
    <div class="notebook-navigation-frame notebook-navigation-frame--centered">
      <NotebookPagination baseHref="/pt-br/laboratorio/caderno-ui" page={5} total={12} />
    </div>
  </section>
</div>

<style>
  .notebook-navigation-showcase {
    display: grid;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .notebook-navigation-section {
    display: grid;
    gap: 1.4rem;
  }

  .notebook-navigation-section > header {
    display: grid;
    gap: 0.3rem;
  }

  .notebook-navigation-section > header p,
  .notebook-navigation-section > header h2,
  .notebook-navigation-section > header span,
  .notebook-navigation-demo h3,
  .notebook-navigation-article :is(h3, h4),
  .notebook-navigation-article p {
    margin: 0;
  }

  .notebook-navigation-section > header p {
    color: var(--site-link-hover);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notebook-navigation-section > header h2 {
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
  }

  .notebook-navigation-section > header span {
    color: var(--site-ink-muted);
  }

  .notebook-navigation-frame,
  .notebook-navigation-demo,
  .notebook-navigation-toc-layout {
    padding: 1.35rem;
    background: color-mix(in srgb, var(--site-surface) 90%, transparent);
    border: 1px solid var(--site-line);
    border-radius: 0.8rem 1rem 0.75rem 0.95rem;
  }

  .notebook-navigation-frame {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .notebook-navigation-frame--centered {
    justify-content: center;
  }

  .notebook-navigation-progress-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .notebook-navigation-demo {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }

  .notebook-navigation-demo--ring {
    justify-items: center;
  }

  .notebook-navigation-demo h3 {
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-lg);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-navigation-toc-layout {
    display: grid;
    grid-template-columns: minmax(12rem, 17rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .notebook-navigation-article {
    display: grid;
    gap: 0.65rem;
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
    line-height: 1.6;
  }

  .notebook-navigation-article h3 {
    padding-top: 0.4rem;
    font-size: 1.25rem;
  }

  .notebook-navigation-article h4 {
    font-size: 1.05rem;
  }

  .notebook-navigation-article p + h3,
  .notebook-navigation-article p + h4 {
    margin-top: 0.65rem;
  }

  @media (max-width: 44rem) {
    .notebook-navigation-toc-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
