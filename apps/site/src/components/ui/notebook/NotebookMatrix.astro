---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Quadrant = {
  description?: string
  icon?: NotebookDoodleName
  position: 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right'
  title: string
  tone: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  class?: string
  quadrants: Quadrant[]
  xAxis?: { high: string; label?: string; low: string }
  yAxis?: { high: string; label?: string; low: string }
}

const {
  class: className,
  quadrants,
  xAxis,
  yAxis,
} = Astro.props

const byPosition = Object.fromEntries(
  quadrants.map((quadrant) => [quadrant.position, quadrant]),
)
const positions: Quadrant['position'][] = [
  'top-left',
  'top-right',
  'bottom-left',
  'bottom-right',
]
---

<figure class:list={['notebook-matrix', className]}>
  {yAxis?.label ? <p class="notebook-matrix__y-title">{yAxis.label}</p> : null}
  <p class="notebook-matrix__y-high">{yAxis?.high ?? ''}</p>
  <p class="notebook-matrix__y-low">{yAxis?.low ?? ''}</p>

  <div class="notebook-matrix__grid">
    {positions.map((position) => {
      const quadrant = byPosition[position]
      if (!quadrant) {
        return <div class="notebook-matrix__cell notebook-matrix__cell--empty" data-position={position}></div>
      }
      return (
        <article class="notebook-matrix__cell" data-position={position} data-tone={quadrant.tone}>
          <header class="notebook-matrix__cell-header">
            {quadrant.icon ? <DoodleIcon name={quadrant.icon} size={20} /> : null}
            <h4>{quadrant.title}</h4>
          </header>
          {quadrant.description ? <p>{quadrant.description}</p> : null}
        </article>
      )
    })}
  </div>

  <p class="notebook-matrix__x-low">{xAxis?.low ?? ''}</p>
  <p class="notebook-matrix__x-high">{xAxis?.high ?? ''}</p>
  {xAxis?.label ? <p class="notebook-matrix__x-title">{xAxis.label}</p> : null}
</figure>

<style>
  .notebook-matrix {
    display: grid;
    grid-template-columns: auto auto 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    grid-template-areas:
      '.       .       y-title'
      '.       y-high  grid'
      '.       y-low   grid'
      '.       .       x-low-high'
      '.       .       x-title';
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
  }

  .notebook-matrix__y-title {
    grid-area: y-title;
    margin: 0 0 0.15rem;
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .notebook-matrix__y-high,
  .notebook-matrix__y-low {
    display: grid;
    place-items: center;
    margin: 0;
    padding-right: 0.15rem;
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .notebook-matrix__y-high {
    grid-row: 2;
    grid-column: 2;
  }

  .notebook-matrix__y-low {
    grid-row: 3;
    grid-column: 2;
  }

  .notebook-matrix__grid {
    grid-area: grid;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.65rem;
    padding: 0.6rem;
    border: 1.5px solid color-mix(in srgb, var(--site-ink-muted) 40%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--site-surface) 90%, transparent);
    position: relative;
  }

  /* eixos internos cruzados */
  .notebook-matrix__grid::before,
  .notebook-matrix__grid::after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--site-ink-muted) 30%, transparent);
    pointer-events: none;
  }

  .notebook-matrix__grid::before {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1.5px;
  }

  .notebook-matrix__grid::after {
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
  }

  .notebook-matrix__cell {
    --cell-bg: var(--notebook-post-it-blue-bg);
    --cell-ink: var(--notebook-post-it-blue-ink);
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 0.8rem 0.9rem 0.9rem;
    color: var(--site-ink);
    background: color-mix(in srgb, var(--cell-bg) 42%, var(--site-surface));
    border-radius: 0.55rem;
    z-index: 1;
  }

  .notebook-matrix__cell--empty {
    background: transparent;
    border: none;
  }

  .notebook-matrix__cell[data-position='top-left'] { grid-row: 1; grid-column: 1; }
  .notebook-matrix__cell[data-position='top-right'] { grid-row: 1; grid-column: 2; }
  .notebook-matrix__cell[data-position='bottom-left'] { grid-row: 2; grid-column: 1; }
  .notebook-matrix__cell[data-position='bottom-right'] { grid-row: 2; grid-column: 2; }

  .notebook-matrix__cell[data-tone='coral'] {
    --cell-bg: var(--notebook-post-it-coral-bg);
    --cell-ink: var(--notebook-post-it-coral-ink);
  }
  .notebook-matrix__cell[data-tone='mint'] {
    --cell-bg: var(--notebook-post-it-mint-bg);
    --cell-ink: var(--notebook-post-it-mint-ink);
  }
  .notebook-matrix__cell[data-tone='lemon'] {
    --cell-bg: var(--notebook-post-it-lemon-bg);
    --cell-ink: var(--notebook-post-it-lemon-ink);
  }
  .notebook-matrix__cell[data-tone='pink'] {
    --cell-bg: var(--notebook-post-it-pink-bg);
    --cell-ink: var(--notebook-post-it-pink-ink);
  }
  .notebook-matrix__cell[data-tone='violet'] {
    --cell-bg: var(--notebook-sticker-violet-bg);
    --cell-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-matrix__cell-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--cell-ink);
  }

  .notebook-matrix__cell-header h4 {
    margin: 0;
    font-family: var(--notebook-font-hand);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .notebook-matrix__cell p {
    margin: 0;
    color: var(--site-ink-soft);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .notebook-matrix__x-low,
  .notebook-matrix__x-high {
    margin: 0;
    padding-top: 0.15rem;
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notebook-matrix__x-low {
    grid-area: x-low-high;
    justify-self: start;
    padding-left: 1rem;
  }

  .notebook-matrix__x-high {
    grid-area: x-low-high;
    justify-self: end;
    padding-right: 1rem;
  }

  .notebook-matrix__x-title {
    grid-area: x-title;
    justify-self: center;
    margin: 0;
    color: var(--site-ink);
    font-family: var(--notebook-font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
