---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Tab = {
  icon?: NotebookDoodleName
  id: string
  label: string
  tone?: 'accent' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  ariaLabel: string
  class?: string
  defaultTab?: string
  groupId: string
  tabs: Tab[]
}

const {
  ariaLabel,
  class: className,
  defaultTab,
  groupId,
  tabs,
}: Props = Astro.props

if (tabs.length === 0) {
  throw new Error('NotebookTabs requires at least one tab.')
}

const tabIds = tabs.map((tab) => tab.id)
if (new Set(tabIds).size !== tabIds.length) {
  throw new Error(`NotebookTabs received duplicate tab ids in group "${groupId}".`)
}

const activeId = defaultTab && tabs.some((tab) => tab.id === defaultTab) ? defaultTab : tabs[0]?.id
---

<div class:list={['notebook-tabs', className]} data-group={groupId}>
  <div aria-label={ariaLabel} class="notebook-tabs__list" role="tablist">
    {tabs.map((tab) => {
      const isActive = tab.id === activeId
      return (
        <button
          aria-controls={`${groupId}-panel-${tab.id}`}
          aria-selected={isActive ? 'true' : 'false'}
          class="notebook-tabs__tab"
          data-tab-id={tab.id}
          data-tone={tab.tone ?? 'accent'}
          id={`${groupId}-tab-${tab.id}`}
          role="tab"
          tabindex={isActive ? 0 : -1}
          type="button"
        >
          {tab.icon ? (
            <span aria-hidden="true" class="notebook-tabs__tab-icon">
              <DoodleIcon name={tab.icon} size={16} />
            </span>
          ) : null}
          <span class="notebook-tabs__tab-label">{tab.label}</span>
        </button>
      )
    })}
  </div>
  <div class="notebook-tabs__panels">
    <slot />
  </div>
</div>

<script>
  function setupNotebookTabs() {
    const groups = document.querySelectorAll<HTMLElement>('.notebook-tabs')

    for (const group of groups) {
      if (group.dataset.tabsReady === 'true') continue

      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
      const panels = Array.from(
        group.querySelectorAll<HTMLElement>('.notebook-tabs__panels > [data-notebook-tab]'),
      )
      const panelsById = new Map(
        panels.map((panel) => [panel.dataset.notebookTab, panel]),
      )
      const records = tabs.flatMap((tab) => {
        const tabId = tab.dataset.tabId
        const panel = tabId ? panelsById.get(tabId) : undefined

        return tabId && panel ? [{ panel, tab, tabId }] : []
      })

      if (records.length === 0 || records.length !== tabs.length || records.length !== panels.length) {
        group.dataset.tabsInvalid = 'true'
        continue
      }

      records.forEach(({ panel, tab, tabId }) => {
        panel.setAttribute('aria-labelledby', tab.id)
        panel.dataset.tone = tab.dataset.tone ?? 'accent'
        panel.id = `${group.dataset.group}-panel-${tabId}`
        panel.role = 'tabpanel'
        panel.tabIndex = 0
      })

      const setActive = (index: number) => {
        records.forEach(({ panel, tab }, itemIndex) => {
          const active = itemIndex === index
          tab.setAttribute('aria-selected', active ? 'true' : 'false')
          tab.tabIndex = active ? 0 : -1
          panel.hidden = !active
        })
      }

      records.forEach(({ tab }, index) => {
        tab.addEventListener('click', () => {
          setActive(index)
          tab.focus()
        })

        tab.addEventListener('keydown', (event) => {
          const key = event.key
          let next = index
          if (key === 'ArrowRight') next = (index + 1) % records.length
          else if (key === 'ArrowLeft') next = (index - 1 + records.length) % records.length
          else if (key === 'Home') next = 0
          else if (key === 'End') next = records.length - 1
          else return
          event.preventDefault()
          setActive(next)
          records[next]?.tab.focus()
        })
      })

      const initialIndex = Math.max(
        0,
        records.findIndex(({ tab }) => tab.getAttribute('aria-selected') === 'true'),
      )
      setActive(initialIndex)
      group.dataset.tabsReady = 'true'
    }
  }

  setupNotebookTabs()
  document.addEventListener('astro:page-load', setupNotebookTabs)
</script>

<style>
  .notebook-tabs {
    display: grid;
    gap: 0;
  }

  .notebook-tabs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.35rem;
    padding: 0 0.15rem;
    position: relative;
    z-index: 1;
  }

  .notebook-tabs__tab {
    --tab-bg: var(--notebook-post-it-blue-bg);
    --tab-ink: var(--notebook-post-it-blue-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem 0.85rem;
    margin: 0;
    color: var(--tab-ink);
    background: color-mix(in srgb, var(--tab-bg) 40%, var(--site-surface));
    border: 1.5px solid color-mix(in srgb, var(--tab-ink) 32%, transparent);
    border-bottom-width: 0;
    border-radius: 0.7rem 0.95rem 0 0;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-md);
    font-weight: var(--notebook-hand-weight-regular);
    line-height: 1;
    cursor: pointer;
    transition: transform 140ms var(--site-transition-smooth), background 140ms var(--site-transition-smooth), padding 140ms var(--site-transition-smooth);
    transform: translateY(0);
  }

  .notebook-tabs__tab:hover {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--tab-bg) 55%, var(--site-surface));
  }

  .notebook-tabs__tab[aria-selected='true'] {
    background: var(--tab-bg);
    color: var(--tab-ink);
    border-color: color-mix(in srgb, var(--tab-ink) 55%, transparent);
    font-weight: 700;
    padding-bottom: 1.05rem;
    transform: translateY(2px);
    box-shadow:
      inset 0 -0.18rem 0.32rem color-mix(in srgb, var(--tab-ink) 22%, transparent),
      inset 0 0.14rem 0 color-mix(in srgb, white 32%, transparent);
  }

  .notebook-tabs__tab:focus-visible {
    outline: 2px dashed var(--tab-ink);
    outline-offset: 3px;
  }

  .notebook-tabs__tab[data-tone='coral'] {
    --tab-bg: var(--notebook-post-it-coral-bg);
    --tab-ink: var(--notebook-post-it-coral-ink);
  }
  .notebook-tabs__tab[data-tone='mint'] {
    --tab-bg: var(--notebook-post-it-mint-bg);
    --tab-ink: var(--notebook-post-it-mint-ink);
  }
  .notebook-tabs__tab[data-tone='lemon'] {
    --tab-bg: var(--notebook-post-it-lemon-bg);
    --tab-ink: var(--notebook-post-it-lemon-ink);
  }
  .notebook-tabs__tab[data-tone='pink'] {
    --tab-bg: var(--notebook-post-it-pink-bg);
    --tab-ink: var(--notebook-post-it-pink-ink);
  }
  .notebook-tabs__tab[data-tone='violet'] {
    --tab-bg: var(--notebook-sticker-violet-bg);
    --tab-ink: var(--notebook-sticker-violet-ink);
  }

  .notebook-tabs__tab-icon {
    display: inline-grid;
    place-items: center;
    transform: rotate(-4deg);
  }

  .notebook-tabs__panels {
    position: relative;
    padding: 1.35rem 1.5rem 1.4rem;
    background: color-mix(in srgb, var(--site-surface) 92%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--site-ink-muted) 32%, transparent);
    border-radius: 0.35rem 0.85rem 0.85rem 0.85rem;
    color: var(--site-ink);
  }

  :global(html[data-js='false']) .notebook-tabs__list {
    display: none;
  }

  :global(html[data-js='false']) .notebook-tabs__panels :global(> [data-notebook-tab] + [data-notebook-tab]) {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--site-line-strong);
  }
</style>
