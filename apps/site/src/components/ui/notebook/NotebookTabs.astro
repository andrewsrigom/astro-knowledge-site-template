---
import CadTabs from '@caderno-ui/astro/Tabs.astro'
import type { CadTabTone } from '@caderno-ui/elements/tabs'
import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Tab = {
  icon?: NotebookDoodleName
  id: string
  label: string
  tone?: CadTabTone
}

type Props = {
  ariaLabel: string
  class?: string
  defaultTab?: string
  groupId: string
  tabs: Tab[]
}

const props: Props = Astro.props
---

<CadTabs {...props}>
  <slot />
</CadTabs>
