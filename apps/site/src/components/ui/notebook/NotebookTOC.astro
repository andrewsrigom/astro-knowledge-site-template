---
type TocItem = {
  id: string
  level?: 2 | 3
  title: string
}

type Props = {
  ariaLabel?: string
  class?: string
  items?: TocItem[]
  selector?: string
  sticky?: boolean
  title?: string
}

const {
  ariaLabel = 'Neste capítulo',
  class: className,
  items = [],
  selector = 'article h2, article h3',
  sticky = false,
  title = 'Neste capítulo',
}: Props = Astro.props
---

<nav
  aria-label={ariaLabel}
  class:list={['notebook-toc', className]}
  data-selector={selector}
  data-sticky={sticky ? 'true' : 'false'}
>
  <p class="notebook-toc__title">{title}</p>
  <ol class="notebook-toc__list">
    {items.map((item, index) => (
      <li data-level={item.level ?? 2}>
        <a aria-current={index === 0 ? 'location' : undefined} href={`#${item.id}`}>{item.title}</a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const headingSlug = (value: string) => value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')

  function setupNotebookTocs() {
    const tocs = document.querySelectorAll<HTMLElement>('.notebook-toc')

    for (const toc of tocs) {
      if (toc.dataset.tocReady === 'true') continue
      const selector = toc.dataset.selector
      const list = toc.querySelector<HTMLOListElement>('.notebook-toc__list')
      if (!selector || !list) continue

      const headings = Array.from(document.querySelectorAll<HTMLElement>(selector))
      if (list.children.length === 0) {
        headings.forEach((heading, index) => {
          if (!heading.id) heading.id = headingSlug(heading.textContent ?? '') || `section-${index + 1}`
          const item = document.createElement('li')
          const link = document.createElement('a')
          item.dataset.level = heading.tagName === 'H3' ? '3' : '2'
          link.href = `#${heading.id}`
          link.textContent = heading.textContent?.trim() ?? heading.id
          item.append(link)
          list.append(item)
        })
      }

      const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      const targets = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((heading): heading is HTMLElement => heading instanceof HTMLElement)

      const setActive = (id: string) => {
        links.forEach((link) => {
          if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
      }

      if (targets.length > 0 && 'IntersectionObserver' in window) {
        const visible = new Map<string, number>()
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visible.set(entry.target.id, entry.boundingClientRect.top)
            else visible.delete(entry.target.id)
          })
          const active = [...visible.entries()].sort((left, right) => Math.abs(left[1]) - Math.abs(right[1]))[0]
          if (active) setActive(active[0])
        }, { rootMargin: '-18% 0px -68% 0px', threshold: [0, 1] })
        targets.forEach((target) => observer.observe(target))
      }

      toc.dataset.tocReady = 'true'
    }
  }

  setupNotebookTocs()
  document.addEventListener('astro:page-load', setupNotebookTocs)
</script>

<style>
  .notebook-toc {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.05rem 1.1rem;
    background: color-mix(in srgb, var(--site-surface) 92%, transparent);
    border: 1px solid var(--site-line);
    border-radius: 0.7rem 0.9rem 0.65rem 0.85rem;
  }

  .notebook-toc[data-sticky='true'] {
    position: sticky;
    top: 1rem;
  }

  .notebook-toc__title {
    width: fit-content;
    padding-bottom: 0.25rem;
    margin: 0;
    color: var(--site-ink);
    border-bottom: 1.5px solid var(--site-line-strong);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notebook-toc__list {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .notebook-toc__list li[data-level='3'] {
    padding-left: 0.85rem;
  }

  .notebook-toc__list a {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0.2rem 0.25rem;
    color: var(--site-ink-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .notebook-toc__list a:hover {
    color: var(--site-link-hover);
  }

  .notebook-toc__list a[aria-current='location'] {
    color: var(--site-ink);
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--notebook-post-it-blue-bg) 64%, transparent) 59%,
      color-mix(in srgb, var(--notebook-post-it-blue-bg) 64%, transparent) 94%,
      transparent 95%
    );
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
  }

  .notebook-toc__list a:focus-visible {
    outline: 2px dashed var(--site-link-hover);
    outline-offset: 3px;
  }
</style>
