---
import TableOfContents from '@caderno-ui/astro/TableOfContents.astro'

type TocItem = { id: string; level?: 2 | 3; title: string }
type Props = { ariaLabel?: string; class?: string; items?: TocItem[]; selector?: string; sticky?: boolean; title?: string }
