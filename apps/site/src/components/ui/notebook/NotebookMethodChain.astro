---
import CadIcon from '@caderno-ui/astro/Icon.astro'
import CadStep from '@caderno-ui/astro/Step.astro'
import CadSteps from '@caderno-ui/astro/Steps.astro'

import type { NotebookDoodleName } from '@/lib/notebook-doodles'

type Step = {
  hint?: string
  icon?: NotebookDoodleName
  label: string
  tone?: 'blue' | 'coral' | 'lemon' | 'mint' | 'pink' | 'violet'
}

type Props = {
  ariaLabel?: string
  class?: string
  direction?: 'horizontal' | 'vertical'
  steps: Step[]
}

const {
  ariaLabel = 'Method steps',
  class: className,
  direction = 'horizontal',
  steps,
}: Props = Astro.props
---

<CadSteps class={className} label={ariaLabel} orientation={direction}>
  {steps.map((step) => (
    <CadStep tone={step.tone ?? 'blue'}>
      <Fragment slot="title">
        {step.icon ? <CadIcon name={step.icon} size={16} /> : null}
        <span>{step.label}</span>
      </Fragment>
      {step.hint}
    </CadStep>
  ))}
</CadSteps>
