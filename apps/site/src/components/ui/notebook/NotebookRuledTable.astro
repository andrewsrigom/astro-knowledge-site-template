---
type TableCell = number | string
type TableColumn = {
  key: string
  label: string
}

type Props = {
  caption?: string
  class?: string
  columns: TableColumn[]
  rows: Record<string, TableCell>[]
}

const {
  caption,
  class: className,
  columns,
  rows,
}: Props = Astro.props
---

<div class:list={['notebook-ruled-table-wrap', className]}>
  <table class="notebook-ruled-table">
    {caption ? <caption>{caption}</caption> : null}
    <thead><tr>{columns.map((column) => <th scope="col">{column.label}</th>)}</tr></thead>
    <tbody>
      {rows.map((row) => <tr>{columns.map((column) => <td>{row[column.key]}</td>)}</tr>)}
    </tbody>
  </table>
</div>

<style>
  .notebook-ruled-table-wrap {
    max-width: 100%;
    overflow-x: auto;
  }

  .notebook-ruled-table {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    color: var(--site-ink);
    font-family: var(--notebook-font-book);
  }

  .notebook-ruled-table caption {
    padding-bottom: 0.55rem;
    color: var(--site-ink-muted);
    text-align: left;
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
  }

  .notebook-ruled-table th,
  .notebook-ruled-table td {
    padding: 0.7rem 0.8rem;
    text-align: left;
    border-bottom: 1px dashed var(--site-line-strong);
    vertical-align: top;
  }

  .notebook-ruled-table th {
    color: var(--site-ink-muted);
    font-family: var(--notebook-font-hand);
    font-size: var(--notebook-hand-sm);
    font-weight: var(--notebook-hand-weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
