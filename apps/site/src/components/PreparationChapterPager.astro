---
import DoodleIcon from '@/components/ui/notebook/DoodleIcon.astro'

type ChapterLink = {
  context: string
  href: string
  title: string
}

type Props = {
  locale: string
  next?: ChapterLink | null
  previous?: ChapterLink | null
}

const { locale, next = null, previous = null } = Astro.props
const labels = locale === 'pt-br'
  ? {
      navigation: 'Navegação entre capítulos',
      next: 'Próximo capítulo',
      previous: 'Capítulo anterior',
    }
  : {
      navigation: 'Chapter navigation',
      next: 'Next chapter',
      previous: 'Previous chapter',
    }
---

{previous || next ? (
  <nav
    aria-label={labels.navigation}
    class="mt-12 grid gap-3 border-t border-dashed border-site-line-strong pt-6 sm:grid-cols-2"
    data-book-secondary-ui
    data-pagefind-ignore
  >
    {previous ? (
      <a
        class="group grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 rounded-md border border-dashed border-site-line-strong bg-site-panel px-4 py-4 transition-colors hover:bg-site-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover"
        href={previous.href}
      >
        <DoodleIcon class="text-site-link-hover" name="arrow-left" size={18} />
        <span class="grid gap-1">
          <span class="[font-family:var(--notebook-font-hand)] text-(--notebook-hand-xs) font-semibold uppercase tracking-[0.12em] text-site-ink-muted">
            {labels.previous}
          </span>
          <strong class="[font-family:var(--notebook-font-book)] leading-5 text-site-ink group-hover:text-site-link-hover">{previous.title}</strong>
          <span class="[font-family:var(--notebook-font-hand)] text-(--notebook-hand-xs) text-site-ink-muted">{previous.context}</span>
        </span>
      </a>
    ) : <span></span>}

    {next ? (
      <a
        class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 rounded-md border border-dashed border-site-line-strong bg-site-panel px-4 py-4 text-right transition-colors hover:bg-site-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover"
        href={next.href}
      >
        <span class="grid gap-1">
          <span class="[font-family:var(--notebook-font-hand)] text-(--notebook-hand-xs) font-semibold uppercase tracking-[0.12em] text-site-ink-muted">
            {labels.next}
          </span>
          <strong class="[font-family:var(--notebook-font-book)] leading-5 text-site-ink group-hover:text-site-link-hover">{next.title}</strong>
          <span class="[font-family:var(--notebook-font-hand)] text-(--notebook-hand-xs) text-site-ink-muted">{next.context}</span>
        </span>
        <DoodleIcon class="text-site-link-hover" name="arrow-right" size={18} />
      </a>
    ) : null}
  </nav>
) : null}
