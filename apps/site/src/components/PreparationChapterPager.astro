---
import NotebookCard from '@/components/ui/notebook/NotebookCard.astro'
import NotebookDivider from '@/components/ui/notebook/NotebookDivider.astro'

type ChapterLink = {
  context: string
  href: string
  title: string
}

type Props = {
  locale: string
  next?: ChapterLink | null
  previous?: ChapterLink | null
}

const { locale, next = null, previous = null } = Astro.props
const labels = locale === 'pt-br'
  ? {
      navigation: 'Navegação entre capítulos',
      next: 'Próximo capítulo',
      previous: 'Capítulo anterior',
    }
  : {
      navigation: 'Chapter navigation',
      next: 'Next chapter',
      previous: 'Previous chapter',
    }
---

{previous || next ? (
  <nav
    aria-label={labels.navigation}
    class="mt-12 grid gap-5"
    data-book-secondary-ui
    data-pagefind-ignore
  >
    <NotebookDivider density="loose" tone="strong" />
    <div class="grid gap-3 sm:grid-cols-2">
      {previous ? (
        <NotebookCard
          cornerFold={false}
          href={previous.href}
          icon="arrow-left"
          kicker={labels.previous}
          title={previous.title}
          variant="outlined"
        >
          <p>{previous.context}</p>
        </NotebookCard>
      ) : <span></span>}

      {next ? (
        <NotebookCard
          cornerFold={false}
          href={next.href}
          icon="arrow-right"
          kicker={labels.next}
          title={next.title}
          tone="accent"
          variant="outlined"
        >
          <p>{next.context}</p>
        </NotebookCard>
      ) : null}
    </div>
  </nav>
) : null}
