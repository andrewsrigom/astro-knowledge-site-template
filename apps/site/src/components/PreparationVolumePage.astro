---
import type { CollectionEntry } from 'astro:content'

import PreparationBookShell from '@/components/PreparationBookShell.astro'
import NotebookBreadcrumb from '@/components/ui/notebook/NotebookBreadcrumb.astro'
import {
  getPreparationVolume,
  resolvePreparationBook,
} from '@/lib/preparation-book'
import { getPreparationCopy } from '@/lib/preparation-copy'
import {
  getPreparationIndexHref,
  getPreparationVolumeHref,
} from '@/lib/preparation-links'
import type { SiteLocale } from '@/lib/site-copy'
import { cn } from '@/lib/cn'
import { ui } from '@/lib/ui'

type Props = {
  catalog: CollectionEntry<'preparationCatalogs'>
  challenges: CollectionEntry<'challenges'>[]
  locale: SiteLocale
  preparation: CollectionEntry<'preparation'>[]
  volumeId: string
}

const { catalog, challenges, locale, preparation, volumeId } = Astro.props
const book = resolvePreparationBook(catalog.data, preparation, challenges)
const volume = getPreparationVolume(book, volumeId)

if (!volume) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  })
}

const copy = getPreparationCopy(locale)
const labels = locale === 'pt-br'
  ? {
      chapter: 'Capítulo',
      chapters: 'Capítulos',
      location: 'Localização no guia',
      practice: 'Prática',
      practices: 'Práticas',
      references: 'Referências cruzadas',
      relations: {
        practice: 'Prática relacionada',
        prerequisite: 'Pré-requisito',
        related: 'Relacionado',
      },
      summary: 'Sumário',
      volume: 'Volume',
    }
  : {
      chapter: 'Chapter',
      chapters: 'Chapters',
      location: 'Guide location',
      practice: 'Practice',
      practices: 'Practices',
      references: 'Cross-references',
      relations: {
        practice: 'Related practice',
        prerequisite: 'Prerequisite',
        related: 'Related',
      },
      summary: 'Contents',
      volume: 'Volume',
    }
const volumeIndex = book.volumes.findIndex((entry) => entry.id === volume.id)
const chapterNumberByGuideId = new Map(
  book.chapters.map((chapter, index) => [chapter.guideId, index + 1]),
)
const currentHref = getPreparationVolumeHref(volume.id, locale)
const breadcrumbItems = [
  { href: getPreparationIndexHref(locale), label: book.catalog.title },
  { label: volume.title },
]
const isDraft = catalog.data.status === 'draft'
---

<PreparationBookShell
  book={book}
  currentVolumeId={volume.id}
  description={volume.description}
  locale={locale}
  localeHrefs={{ [locale]: currentHref }}
  noindex={isDraft}
  pagefind={!isDraft}
  title={volume.title}
>
  <article class="mx-auto w-full max-w-304 px-5 pb-16 pt-10 sm:px-8 lg:px-12 xl:px-14 xl:pt-16">
    <header class="max-w-4xl border-b border-dashed border-site-line-strong pb-10">
      <NotebookBreadcrumb
        ariaLabel={labels.location}
        items={breadcrumbItems}
      />
      <p class={cn(ui.eyebrow, 'mb-0 mt-7')}>
        {labels.volume} {String(volumeIndex + 1).padStart(2, '0')}
      </p>
      <h1 class="preparation-volume-title mb-0 mt-3 text-[clamp(2.7rem,6vw,5rem)] font-semibold leading-[0.98] tracking-[-0.045em] text-site-ink">
        {volume.title}
      </h1>
      <div class="mt-6 h-0.5 w-14 bg-site-accent"></div>
      <p class="mb-0 mt-7 max-w-[65ch] text-[1.05rem] leading-8 text-site-ink-soft">
        {volume.description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <p class={ui.metaQuiet}>
          {book.chapters.filter((chapter) => chapter.volumeId === volume.id).length} {labels.chapters.toLowerCase()}
        </p>
        {isDraft ? <span class={ui.badge}>{copy.draft}</span> : null}
      </div>
    </header>

    <nav
      aria-label={`${labels.summary}: ${volume.title}`}
      class="mt-12 grid gap-12"
      data-pagefind-ignore
      data-preparation-chapter-list
    >
      {volume.parts.map((part, partIndex) => (
        <section aria-labelledby={`volume-${volume.id}-${part.id}`} class="grid gap-4">
          <header class="grid gap-1 border-b border-dashed border-site-line-strong pb-3 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-4">
            <p class={ui.metaQuiet}>{String(partIndex + 1).padStart(2, '0')}</p>
            <div class="grid gap-1.5">
              <h2 class={ui.headingCompact} id={`volume-${volume.id}-${part.id}`}>{part.title}</h2>
              {part.description ? (
                <p class={cn(ui.cardDescription, 'max-w-3xl text-sm leading-6 sm:text-[0.97rem]')}>
                  {part.description}
                </p>
              ) : null}
            </div>
          </header>

          {part.chapters.length > 0 ? (
            <ol class="m-0 grid list-none gap-0 p-0 sm:ml-24">
              {part.chapters.map((chapter) => (
                <li class="border-t border-dashed border-site-line-strong first:border-t-0">
                  <a
                    class="group grid gap-1 py-4 text-inherit transition-colors hover:text-site-link-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover md:grid-cols-[8rem_minmax(0,1fr)] md:gap-4"
                    href={chapter.href}
                  >
                    <span class={ui.metaQuiet}>
                      {labels.chapter} {String(chapterNumberByGuideId.get(chapter.guideId) ?? '').padStart(2, '0')}
                    </span>
                    <span class="grid gap-1">
                      <strong class="text-base leading-6 text-site-link-hover group-hover:text-site-ink group-focus-visible:text-site-ink lg:text-[1.08rem]">
                        {chapter.guide.data.title}
                      </strong>
                      <span class={ui.cardDescription}>{chapter.guide.data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ) : null}

          {part.practices.length > 0 ? (
            <aside class="grid gap-3 rounded-md border border-dashed border-site-line-strong bg-site-panel-muted px-4 py-4 sm:ml-24">
              <p class={cn(ui.eyebrow, 'mb-0')}>{labels.practices}</p>
              <ul class="m-0 grid list-none gap-3 p-0">
                {part.practices.map((practice) => (
                  <li>
                    <a
                      class="group grid gap-1 text-inherit transition-colors hover:text-site-link-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover md:grid-cols-[8rem_minmax(0,1fr)] md:gap-4"
                      href={practice.href}
                    >
                      <span class={ui.metaQuiet}>{labels.practice}</span>
                      <span class="grid gap-1">
                        <strong class="leading-6 text-site-link-hover group-hover:text-site-ink group-focus-visible:text-site-ink">
                          {practice.challenge.data.title}
                        </strong>
                        <span class={ui.cardDescription}>{practice.challenge.data.description}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          ) : null}

          {part.references.length > 0 ? (
            <aside class="grid gap-2 sm:ml-24">
              <p class={cn(ui.eyebrow, 'mb-0')}>{labels.references}</p>
              <ul class="m-0 grid list-none gap-1 p-0 sm:grid-cols-2">
                {part.references.map((reference) => (
                  <li>
                    <a
                      class="group grid gap-0.5 rounded-md px-2 py-2 text-inherit transition-colors hover:bg-site-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-dashed focus-visible:outline-site-link-hover"
                      href={reference.href}
                    >
                      <span class={ui.metaQuiet}>{labels.relations[reference.relation]}</span>
                      <span class="font-medium leading-6 text-site-link-hover group-hover:text-site-ink group-focus-visible:text-site-ink">
                        {reference.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          ) : null}
        </section>
      ))}
    </nav>
  </article>
</PreparationBookShell>

<style>
  .preparation-volume-title {
    font-family: var(--notebook-font-book);
  }
</style>
